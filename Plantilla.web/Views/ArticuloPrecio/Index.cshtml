<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.17.1/xlsx.full.min.js"></script>

<script>
    const _urlAp = "@Url.Content("~/ArticuloPrecio/")";
    const MODULO_DESCUENTOS = '@Session["MOD_DESCUENTOS"]'
    const PERMISOS_MOD_DESCUENTOS = '@Session["PERMISOS_DESCUENTOS"]'



    function updateFileNameAP(input) {
        var fileName = input.files[0].name; // Obtener el nombre del archivo seleccionado
        var descripcionFile = document.getElementById('descripcionFileAP');

        descripcionFile.value = fileName; // Asignar el nombre del archivo al campo de descripción
        descripcionFile.disabled = true; // Deshabilitar el campo de descripción
    }


    function uploadExcelAP() {
        let botonProcesar = document.getElementById('bt_ProcesarPrecioArticulo');
        botonProcesar.disabled = true; // Deshabilitar el boton procesar
        var fileInput = document.getElementById('excelFile');
        var formData = new FormData();

        let archivoNombre = $('#descripcionFileAP').val();
        console.log(archivoNombre);
        //validamos que sea el cargador correcto
        if (archivoNombre === 'CargadorArticuloPrecio.xlsx') {

            // Accede a la propiedad files solo si el elemento existe y tiene archivos seleccionados
            if (fileInput.files.length > 0) {
                formData.append('excelFile', fileInput.files[0]);
                fetch(`${_urlAp}/UploadExcelAP`, {
                    method: 'POST',
                    body: formData
                })
                    .then(response => {
                        if (!response.ok) {
                            throw new Error('Error procesando documentos excel.');
                        }
                        return response.json();
                    })
                    .then(data => {
                        toastr.success("Archivo subido y procesado exitosamente.", "Éxito", toastrOptions);
                        closeUploadModalAP(); // Cierra el modal después de subir el archivo
                        KTDatatablesArticuloPrecio.init();
                    })
                    .catch(error => {
                        console.error('Error:', error);
                        //alert('Error procesando documentos excel.');
                        toastr.warning("Error procesando documentos excel.", "Error", toastrOptions);
                        closeUploadModalDesc(); // Cierra el modal después de subir el archivo
                    })
                    .finally(() => {
                        botonProcesar.disabled = false;
                    });
            } else {
                toastr.warning("Por favor seleccione un archivo.", "Advertencia", toastrOptions);
                botonProcesar.disabled = false; // Habilita el boton procesar
            }
        } else {
            toastr.error("Por favor seleccione un cargador valido para artículo precio.", "Error", toastrOptions);
            botonProcesar.disabled = false; // Habilita el boton procesar
        }
    }

</script>

@Scripts.Render(System.Web.Optimization.BundleTable.Bundles.ResolveBundleUrl("~/bundles/ArticuloPrecioIndex", true))
