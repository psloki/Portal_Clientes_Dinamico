<div class="modal fade" id="ModalPrecio" data-backdrop="static" tabindex="-1" role="dialog" aria-labelledby="staticBackdrop" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Editar precio</h5>
                <!--begin::Close-->
                <div class="btn btn-icon btn-sm btn-active-light-primary ms-2" data-bs-dismiss="modal" aria-label="Close">
                    <span class="svg-icon svg-icon-muted svg-icon-2x">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path opacity="0.3" d="M6 19.7C5.7 19.7 5.5 19.6 5.3 19.4C4.9 19 4.9 18.4 5.3 18L18 5.3C18.4 4.9 19 4.9 19.4 5.3C19.8 5.7 19.8 6.29999 19.4 6.69999L6.7 19.4C6.5 19.6 6.3 19.7 6 19.7Z" fill="currentColor" />
                            <path d="M18.8 19.7C18.5 19.7 18.3 19.6 18.1 19.4L5.40001 6.69999C5.00001 6.29999 5.00001 5.7 5.40001 5.3C5.80001 4.9 6.40001 4.9 6.80001 5.3L19.5 18C19.9 18.4 19.9 19 19.5 19.4C19.3 19.6 19 19.7 18.8 19.7Z" fill="currentColor" />
                        </svg>
                    </span>
                </div>
                <!--end::Close-->
            </div>
            <div class="modal-body">
                <div class="col-md-12 mb-3 form-group">
                    <label>Precio actual</label>
                    <input disabled type="text" class="form-control" id="precioactual" value="0" />
                </div>
                <div class="col-md-12 mb-3 form-group">
                    <label>Precio nuevo</label>
                    <input type="text" class="form-control currency-mask" id="precionuevo" value="0" />
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary font-weight-bold" data-bs-dismiss="modal">Cerrar</button>
                    <button type="button" id="btnGuardarPrecioArticulo" onclick="guardarPrecio()" class="btn btn-primary font-weight-bold" value="Default">Guardar</button>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="ModalDescuento" data-backdrop="static" tabindex="-1" role="dialog" aria-labelledby="staticBackdrop" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Editar descuento temporal</h5>
                <!--begin::Close-->
                <div class="btn btn-icon btn-sm btn-active-light-primary ms-2" data-bs-dismiss="modal" aria-label="Close">
                    <span class="svg-icon svg-icon-muted svg-icon-2x">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path opacity="0.3" d="M6 19.7C5.7 19.7 5.5 19.6 5.3 19.4C4.9 19 4.9 18.4 5.3 18L18 5.3C18.4 4.9 19 4.9 19.4 5.3C19.8 5.7 19.8 6.29999 19.4 6.69999L6.7 19.4C6.5 19.6 6.3 19.7 6 19.7Z" fill="currentColor" />
                            <path d="M18.8 19.7C18.5 19.7 18.3 19.6 18.1 19.4L5.40001 6.69999C5.00001 6.29999 5.00001 5.7 5.40001 5.3C5.80001 4.9 6.40001 4.9 6.80001 5.3L19.5 18C19.9 18.4 19.9 19 19.5 19.4C19.3 19.6 19 19.7 18.8 19.7Z" fill="currentColor" />
                        </svg>
                    </span>
                </div>
                <!--end::Close-->
            </div>
            <div class="modal-body">
                <div class="col-md-12 mb-3 form-group">
                    <label>Descuento temporal</label>
                    <input type="number" step="0.01" class="form-control" id="desctemp" value="0.00" />
                </div>
                <div class="col-md-12 mb-3 form-group">
                    <label>Fecha expiración del descuento temporal</label>
                    <input type="text" class="form-control" id="fechaexp" readonly value="01/01/1980" />
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary font-weight-bold" data-bs-dismiss="modal">Cerrar</button>
                    <button type="button" onclick="guardarDescuento()" class="btn btn-primary font-weight-bold" value="Default">Guardar</button>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="ModalArticuloPrecio" data-backdrop="static" tabindex="-1" role="dialog" aria-labelledby="staticBackdrop" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Actualizar Precios</h5>
                <!--begin::Close-->
                <div class="btn btn-icon btn-sm btn-active-light-primary ms-2" data-bs-dismiss="modal" aria-label="Close">
                    <span class="svg-icon svg-icon-muted svg-icon-2x">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path opacity="0.3" d="M6 19.7C5.7 19.7 5.5 19.6 5.3 19.4C4.9 19 4.9 18.4 5.3 18L18 5.3C18.4 4.9 19 4.9 19.4 5.3C19.8 5.7 19.8 6.29999 19.4 6.69999L6.7 19.4C6.5 19.6 6.3 19.7 6 19.7Z" fill="currentColor" />
                            <path d="M18.8 19.7C18.5 19.7 18.3 19.6 18.1 19.4L5.40001 6.69999C5.00001 6.29999 5.00001 5.7 5.40001 5.3C5.80001 4.9 6.40001 4.9 6.80001 5.3L19.5 18C19.9 18.4 19.9 19 19.5 19.4C19.3 19.6 19 19.7 18.8 19.7Z" fill="currentColor" />
                        </svg>
                    </span>
                </div>
                <!--end::Close-->
            </div>
            <div class="modal-body">
                <div id="popup" class="popup">
                    <div class="popup-content">
                        <span class="close" onclick="CerrarPopup()">&times;</span>
                        <div id="datosExcel"></div>
                    </div>
                </div>

                <!-- Aquí puedes añadir cualquier otro contenido que necesites en el cuerpo del modal -->

                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary font-weight-bold" data-bs-dismiss="modal">Cerrar</button>
                    <button type="button" onclick="guardarDescuento()" class="btn btn-primary font-weight-bold" value="Default">Guardar</button>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade in" id="EdiModalPrecioArticulo" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true" data-backdrop="static" data-keyboard="false">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="fw-bold" id="ActualizarDescuento">Subir archivo</h2>
                <div class="btn btn-icon btn-sm btn-active-icon-primary" data-kt-roles-modal-action="close" onclick="closeUploadModalDesc();">
                    <span class="svg-icon svg-icon-1">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <rect opacity="0.5" x="6" y="17.3137" width="16" height="2" rx="1" transform="rotate(-45 6 17.3137)"
                                  fill="currentColor" />
                            <rect x="7.41422" y="6" width="16" height="2" rx="1" transform="rotate(45 7.41422 6)"
                                  fill="currentColor" />
                        </svg>
                    </span>
                </div>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-md-12 mt-2 mb-4">
                        <label for="descripcionFileAP">Descripción</label>
                        <input name="descripcionFileDesc" id="descripcionFileAP" class="form-control" value="" placeholder="Descripción del cargador" />
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-12 archivos dz-filename">
                        <!-- Campo de entrada de archivos -->
                        <input type="file" class="form-control-file" id="excelFile" required name="excelFile" onchange="updateFileNameAP(this)">
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <!-- Botón de aceptar que llama a la función uploadExcel() -->
                <button type="button" class="btn btn-primary font-weight-bold" id="bt_ProcesarPrecioArticulo" onclick="uploadExcelAP();">Procesar</button>
                <button type="button" class="btn btn-danger font-weight-bold" data-dismiss="modal" onclick="closeUploadModalAP()">Cerrar</button>
            </div>
        </div>
    </div>
</div>
<div class="modal fade" id="ModalPrecioMasivo" data-backdrop="static"
     tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">Editar precios</h5>
                <button type="button" class="btn btn-icon btn-sm btn-active-light-primary"
                        data-bs-dismiss="modal" aria-label="Close">
                    <span class="svg-icon svg-icon-muted svg-icon-2x">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24">
                            <path opacity=".3"
                                  d="M6 19.7a1 1 0 0 1-1.4-1.4L10.6 12 4.6 6a1 1 0 0 1 1.4-1.4L12 10.6l6-6a1 1 0 0 1 1.4 1.4l-6 6 6 6a1 1 0 0 1-1.4 1.4l-6-6-6 6Z"
                                  fill="currentColor" />
                            <path d="M18.8 19.7a1 1 0 0 1-1.4 0l-5.4-5.3-5.4 5.3a1 1 0 0 1-1.4-1.4l5.3-5.3-5.3-5.3a1 1 0 1 1 1.4-1.4l5.4 5.3 5.4-5.3a1 1 0 1 1 1.4 1.4l-5.3 5.3 5.3 5.3a1 1 0 0 1 0 1.4Z"
                                  fill="currentColor" />
                        </svg>
                    </span>
                </button>
            </div>

            <div class="modal-body">
                <div class="col-md-12 mb-3 form-group">
                    <label>Cantidad afectada</label>
                    <input type="text"
                           id="cantArticulosMasivo"
                           class="form-control"
                           disabled
                           value="0 artículo" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Nuevo precio</label>
                    <input type="text" id="precioNuevoMasivo"
                           class="form-control currency-mask" value="0" />
                </div>
            </div>

            <div class="modal-footer">
                <button class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
                <button class="btn btn-primary" onclick="guardarPrecioMasivo()">Guardar</button>
            </div>

        </div>
    </div>
</div>
<div class="modal fade" id="ModalCopiarNivelPrecio" data-backdrop="static" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Copiar nivel de precio</h5>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="form-group col-12">
                        <label>Nivel de precio - Origen</label>
                        <select id="nivelPrecioOrigen" name="nivelPrecioOrigen" class="form-select" data-control="select2" data-placeholder="Filtrar por nivel de precio" data-dropdown-parent="#ModalCopiarNivelPrecio">
                            @*onchange="cargarArticuloNP(this.value)"*@
                            <option></option>
                            @{
                                if (ViewBag.NivelPrecioAP != null)
                                {
                                    foreach (var item in ViewBag.NivelPrecioAP)
                                    {
                                        <option value="@item.NIVEL_PRECIO">  @item.NIVEL_PRECIO</option>
                                    }
                                }
                            }
                        </select>
                    </div>
                    <div class="form-group col-12 mt-3">
                        <label>Nivel de precio - Destino</label>
                        <select id="nivelPrecioDestino" name="nivelPrecioDestino" class="form-select filtro" data-control="select2" data-placeholder="Filtrar por nivel de precio" data-dropdown-parent="#ModalCopiarNivelPrecio">
                            @*onchange="cargarArticuloNP(this.value)"*@
                            <option></option>
                            @{
                                if (ViewBag.NivelPrecioAP != null)
                                {
                                    foreach (var item in ViewBag.NivelPrecioAP)
                                    {
                                        <option value="@item.NIVEL_PRECIO">  @item.NIVEL_PRECIO</option>
                                    }
                                }
                            }
                        </select>
                    </div>
                    <div class="form-group col-12 mt-3">
                        <label class="form-label" for="porcentaje">Porcentaje</label>
                        <input id="porcentaje" type="number" class="form-control" value="0" min="0" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
                    <button type="button" class="btn btn-primary" onclick="copiarNivelPrecio()">Copiar</button>
                </div>
            </div>
        </div>
    </div>
</div>

