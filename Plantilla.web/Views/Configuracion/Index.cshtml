@*++++++++++++++++++++++++++++++++++++++++++++++++MODAL AGREGAR ESTADO ++++++++++++++++++++++++++++++++++++++++++++++++++++++*@
<div class="modal fade" tabindex="-1" id="NuevoSeguimientoModal">
    <div class="modal-dialog modal-dialog-centered ">
        <div class="modal-content">
            <div class="modal-header">
                <h3 class="modal-title" id="NuevoSeguimientoModalLabel">Estado nuevo</h3>

                <!--begin::Close-->
                <div class="btn btn-icon btn-sm btn-active-light-primary ms-2" data-bs-dismiss="modal" aria-label="Close">
                    <span class="svg-icon svg-icon-muted svg-icon-2x">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path opacity="0.3" d="M6 19.7C5.7 19.7 5.5 19.6 5.3 19.4C4.9 19 4.9 18.4 5.3 18L18 5.3C18.4 4.9 19 4.9 19.4 5.3C19.8 5.7 19.8 6.29999 19.4 6.69999L6.7 19.4C6.5 19.6 6.3 19.7 6 19.7Z" fill="currentColor" />
                            <path d="M18.8 19.7C18.5 19.7 18.3 19.6 18.1 19.4L5.40001 6.69999C5.00001 6.29999 5.00001 5.7 5.40001 5.3C5.80001 4.9 6.40001 4.9 6.80001 5.3L19.5 18C19.9 18.4 19.9 19 19.5 19.4C19.3 19.6 19 19.7 18.8 19.7Z" fill="currentColor" />
                        </svg>
                    </span>
                </div>
                <!--end::Close-->
            </div>

            <div class="modal-body">
                <div class="row">
                    <div class="form-group mb-6">
                        <label>Estado</label>
                        <input type="text" class="form-control text-gray-500" id="EstadoIns" style="font-size:0.90rem;" name="EstadoIns" autocomplete="off" value="" placeholder="Ingrese el nombre del nuevo estado" />
                    </div>
                    <div class="form-group mb-6">
                        <label>Descripción</label>
                        <input type="text" class="form-control text-gray-500" id="DescripcionInsDescripcionIns" style="font-size:0.90rem;" name="desc" placeholder="Descripción TLA" autocomplete="off" value="" />
                    </div>
                    <div class="form-group mb-6">
                        <label>Color hexadecimal</label>
                        <select id="coloresIns" name="coloresIns" class="form-select" data-control="select2" data-placeholder="Seleccione un color">
                            <option></option>
                            @if (ViewBag.Segui_Pedido != null)
                            {
                                foreach (var item in ViewBag.Segui_Pedido)
                                {
                                    <option value="@item.COLOR">@item.ESTADO</option>
                                }
                            }
                        </select>
                    </div>


                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" id="AgregarSucesos" onclick="GuardarEstadoPedidos();" value="Default" class="btn btn-success">Guardar</button>
            </div>
        </div>
    </div>
</div>
