
@{
    ViewBag.Title = "Descuentos Cliente";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<!--begin::Content wrapper-->
<div class="d-flex flex-column flex-column-fluid">

    <!--begin::Content-->
    <div id="kt_app_content" class="app-content flex-column-fluid">
        <!--begin::Content container-->
        <div id="kt_app_content_container" class="app-container container-xxl" style="max-width:100% !important">
            <!--begin::Toolbar-->
            <div id="kt_app_toolbar" class="app-toolbar py-3 py-lg-6">
                <!--begin::Page title-->
                <div class="page-title d-flex flex-column justify-content-center flex-wrap me-3">
                    <!--begin::Title-->
                    <h1 class="page-heading d-flex text-dark fw-bold fs-3 flex-column justify-content-center my-0">@ViewBag.Title</h1>
                    <!--end::Title-->
                </div>
                <!--end::Page title-->
            </div>
            <!--end::Toolbar-->
            <!--begin::Card-->
            <div class="card mb-6">
                <!--begin::Card body-->
                <div class="card-body pt-0">
                    <div class="row align-items-center mt-7">

                        <div class="form-group col-md-2 mt-3 ">
                            <label>Cliente</label>
                            <select id="descCliente" name="descCliente" class="form-select " data-control="select2" data-placeholder="Filtrar por cliente">
                                <option></option>
                                @{
                                    if (ViewBag.ClienteDesc != null)
                                    {
                                        foreach (var item in ViewBag.ClienteDesc)
                                        {
                                            <option value="@item.CLIENTE">@item.CLIENTE | @item.ALIAS</option>
                                        }
                                    }
                                }
                            </select>
                        </div>
                        @*<div class="form-group col-md-2 mt-3">
                                <label>Nivel de precio</label>
                                <select id="nivelprecioDesc" name="nivelprecioDesc" class="form-select filtro" data-control="select2" data-placeholder="Filtrar por nivel de precio">
                                    <option></option>
                                    <option selected value="DETALLE">DETALLE</option>
                                    @{
                                        if (ViewBag.NivelPrecioDesc != null)
                                        {
                                            foreach (var item in ViewBag.NivelPrecioDesc)
                                            {
                                                <option value="@item.NIVEL_PRECIO">@item.NIVEL_PRECIO</option>
                                            }
                                        }
                                    }
                                </select>
                            </div>*@
                        <div class="form-group col-md-2 mt-3">
                            <label>Artículo</label>
                            <select id="descArticulo" name="articulosDesc" class="form-select" data-control="select2" data-placeholder="Filtrar por un artículo">
                                <option></option>
                                <option selected value="0">Todos</option>
                                @{
                                    if (ViewBag.ArticuloDesc != null)
                                    {
                                        foreach (var item in ViewBag.ArticuloDesc)
                                        {
                                            <option value="@item.ARTICULO">@item.ARTICULO | @item.DESCRIPCION</option>
                                        }
                                    }
                                }
                            </select>
                        </div>

                        <div class="form-group col-md-2 mt-3">
                            <label>Categoría cliente</label>
                            <select id="descCategoria" name="categoriaDesc" class="form-select filtro" data-control="select2" data-placeholder="Filtrar por categoría">
                                <option></option>
                                <option selected value="0">Todas</option>
                                @{
                                    if (ViewBag.CategoriaDesc != null)
                                    {
                                        foreach (var item in ViewBag.CategoriaDesc)
                                        {
                                            <option value="@item.CATEGORIA_CLIENTE">@item.CATEGORIA_CLIENTE | @item.DESCRIPCION</option>
                                        }
                                    }
                                }
                            </select>
                        </div>
                        <div class="form-group col-md-2 mt-3">
                            <label>Casa</label>
                            <select id="descCasa" name="descCasa" class="form-select filtro" data-control="select2" multiple data-placeholder="Filtrar por Casa">
                                <option></option>
                                <option selected value="0">Todas</option>
                                @{
                                    if (ViewBag.CasaArtDesc != null)
                                    {
                                        foreach (var item in ViewBag.CasaArtDesc)
                                        {
                                            <option value="@item.CLASIFICACION">@item.CLASIFICACION | @item.DESCRIPCION</option>
                                        }
                                    }
                                }
                            </select>
                        </div>

                        <div class="form-group col-md-2 mt-3">
                            <label>SubCasa</label>
                            <select id="descSubCasa" name="descSubCasa" class="form-select filtro" data-control="select2" multiple data-placeholder="Filtrar por marca">
                                <option></option>
                                <option selected value="0">Todas</option>
                                @{
                                    if (ViewBag.MarcaArtDesc != null)
                                    {
                                        foreach (var item in ViewBag.MarcaArtDesc)
                                        {
                                            <option value="@item.CLASIFICACION">@item.CLASIFICACION | @item.DESCRIPCION</option>
                                        }
                                    }
                                }
                            </select>
                        </div>

                        @*<div class="form-group col-md-2 mt-3">
                                <label>Estatus Artículo</label>
                                <select id="descSubCasa" name="descSubCasa" class="form-select filtro" data-control="select2" multiple data-placeholder="Filtrar por SubCasa">
                                    <option></option>
                                    <option selected value="0">Todas</option>
                                    @{
                                        if (ViewBag.SubCasaArtDesc != null)
                                        {
                                            foreach (var item in ViewBag.SubCasaArtDesc)
                                            {
                                                <option value="@item.CLASIFICACION">@item.CLASIFICACION | @item.DESCRIPCION</option>
                                            }
                                        }
                                    }
                                </select>
                            </div>*@

                        <div class="col-md-2 mt-8">
                            <div class="input-icon">
                                <input type="text" class="form-control" placeholder="Buscar..." id="kt_datatable_search_queryDescCli" data-kt-docs-table-filter="search" autocomplete="off" />
                                <span>
                                    <i class="flaticon2-search-1 text-muted"></i>
                                </span>
                            </div>
                        </div>

                    </div>
                </div>
                <!--end::Card body-->
            </div>
            <!--end::Card-->
            <!--begin::Card-->
            <div class="card">
                <!--begin::Card body-->
                <div class="card-body pt-0">
                    <div class="table-responsive">
                        <!--begin::Table-->
                        <table class="table align-middle table-row-dashed fs-6 gy-4" id="miTabla">
                            <!--begin::Table head-->
                            <thead>
                                <!--begin::Table row-->
                                <tr class="text-start text-gray-600 fw-bold fs-7 text-uppercase gs-0">
                                    <th class="min-w-10px pe-2">
                                        <div class="form-check form-check-sm form-check-custom form-check-solid me-3">
                                            <input class="form-check-input" id="checkAll" type="checkbox" data-kt-check="true" data-kt-check-target="#miTabla .form-check-input" value="1" />
                                        </div>
                                    </th>
                                    <th class="text-left min-w-80px">Cat.Cliente</th>
                                    <th class="text-left min-w-200px ">Cliente</th>
                                    @*<th class="text-left min-w-100px ">Nivel precio</th>*@
                                    <th class="text-left min-w-200px">Artículo</th>
                                    <th class="text-left min-w-150px">Casa</th>
                                    <th class="text-left min-w-150px">SubCasa</th>
                                    <th class="text-left min-w-150px">Categoria Art.</th>
                                    @*<th class="min-w-75px" style="text-align:right">Precio</th>*@
                                    <th class="min-w-100px" style="text-align:right">Desc temp.</th>
                                    <th class="min-w-100px" style="text-align:right">Fecha Inicio.</th>
                                    <th class="min-w-100px" style="text-align:right">Fecha Fin.</th>
                                    @*<th class="min-w-100px" style="text-align:right">Precio final</th>*@
                                    <th class="text-left min-w-100px">Acciones</th>
                                    @*<th class="text-end"></th>*@
                                </tr>
                                <!--end::Table row-->
                            </thead>
                            <!--end::Table head-->
                        </table>
                        <!--end::Table-->
                    </div>
                    
                </div>
                <!--end::Card body-->
            </div>
            <!--end::Card-->
        </div>
        <!--end::Content container-->
    </div>
    <!--end::Content-->
</div>
<!--end::Content wrapper-->


<div class="modal fade" id="ModalEdiDescuento" data-backdrop="static" tabindex="-1" role="dialog" aria-labelledby="staticBackdrop" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Editar Descuento</h5>
                <!--begin::Close-->
                <div class="btn btn-icon btn-sm btn-active-light-primary ms-2" data-bs-dismiss="modal" aria-label="Close">
                    <span class="svg-icon svg-icon-muted svg-icon-2x">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path opacity="0.3" d="M6 19.7C5.7 19.7 5.5 19.6 5.3 19.4C4.9 19 4.9 18.4 5.3 18L18 5.3C18.4 4.9 19 4.9 19.4 5.3C19.8 5.7 19.8 6.29999 19.4 6.69999L6.7 19.4C6.5 19.6 6.3 19.7 6 19.7Z" fill="currentColor" />
                            <path d="M18.8 19.7C18.5 19.7 18.3 19.6 18.1 19.4L5.40001 6.69999C5.00001 6.29999 5.00001 5.7 5.40001 5.3C5.80001 4.9 6.40001 4.9 6.80001 5.3L19.5 18C19.9 18.4 19.9 19 19.5 19.4C19.3 19.6 19 19.7 18.8 19.7Z" fill="currentColor" />
                        </svg>
                    </span>
                </div>
                <!--end::Close-->
            </div>
            <div class="modal-body">
                <div class="col-md-12 mb-3 form-group">
                    <label>Cliente</label>
                    <input disabled type="text" class="form-control" id="descuentoCliente" value="" />
                </div>
                <div class="col-md-12 mb-3 form-group">
                    <label>Articulo</label>
                    <input disabled type="text" class="form-control" id="descuentoArticulo" value="" />
                </div>
                <div class="col-md-12 mb-3 form-group">
                    <label>Cantidad Min</label>
                    <input type="number" class="form-control" id="CantidadMinCli" value="1" />
                </div>
                <div class="col-md-12 mb-3 form-group">
                    <label>Cantidad Max</label>
                    <input type="number" class="form-control" id="CantidadMaxCli" value="1" />
                </div>
                <div class="col-md-12 mb-3 form-group">
                    <label>Porc Descuento</label>
                    <input type="number" class="form-control" id="PorDescuentoCli" value="1" />
                </div>
                <div class="col-md-12 mb-3 form-group">
                    <label>Fecha Inicio</label>
                    <input type="text" class="form-control" id="fechaIniDesc" value="" />
                </div>
                <div class="col-md-12 mb-3 form-group">
                    <label>Fecha Final </label>
                    <input type="text" class="form-control" id="fechaFinalDesc" value="" />
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary font-weight-bold" data-bs-dismiss="modal">Cerrar</button>
                    <button type="button" id="btnGuardarDescuentoCliente" onclick="guardarDescuento();" class="btn btn-primary font-weight-bold" value="Default">Guardar</button>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="ModalDescuento" data-backdrop="static" tabindex="-1" role="dialog" aria-labelledby="staticBackdrop" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">Editar Descuento</h5>
                <div class="btn btn-icon btn-sm btn-active-light-primary ms-2" data-bs-dismiss="modal" aria-label="Close">
                    <span class="svg-icon svg-icon-muted svg-icon-2x">
                    </span>
                </div>
            </div>

            <div class="modal-body">
                <div class="col-md-12 mb-3 form-group">
                    <label>Cliente</label>
                    <input disabled type="text" class="form-control" id="descuentoCliente" value="" />
                </div>
                <div class="col-md-12 mb-3 form-group">
                    <label>Artículo</label>
                    <input disabled type="text" class="form-control" id="descuentoArticulo" value="" />
                </div>
                <div class="col-md-12 mb-3 form-group">
                    <label>Cantidad Min</label>
                    <input type="number" class="form-control" id="CantidadMinCli" value="1" />
                </div>
                <div class="col-md-12 mb-3 form-group">
                    <label>Cantidad Max</label>
                    <input type="number" class="form-control" id="CantidadMaxCli" value="1" />
                </div>
                <div class="col-md-12 mb-3 form-group">
                    <label>Porc Descuento</label>
                    <input type="number" class="form-control" id="PorDescuentoCli" value="1" />
                </div>
                <div class="col-md-12 mb-3 form-group">
                    <label>Fecha Inicio</label>
                    <input type="text" class="form-control" id="fechaIniDesc" value="" />
                </div>
                <div class="col-md-12 mb-3 form-group">
                    <label>Fecha Final</label>
                    <input type="text" class="form-control" id="fechaFinalDesc" value="" />
                </div>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-secondary font-weight-bold" data-bs-dismiss="modal">Cerrar</button>
                <button type="button" onclick="guardarDescuentoMasivo();" class="btn btn-primary font-weight-bold">Guardar</button>
            </div>

        </div>
    </div>
</div>


<div class="modal fade in" id="EdiModalDescuento" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true" data-backdrop="static" data-keyboard="false">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="fw-bold" id="ActualizarDescuento">Subir archivo</h2>
                <div class="btn btn-icon btn-sm btn-active-icon-primary" data-kt-roles-modal-action="close" onclick="closeUploadModalDesc();">
                    <span class="svg-icon svg-icon-1">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <rect opacity="0.5" x="6" y="17.3137" width="16" height="2" rx="1" transform="rotate(-45 6 17.3137)"
                                  fill="currentColor" />
                            <rect x="7.41422" y="6" width="16" height="2" rx="1" transform="rotate(45 7.41422 6)"
                                  fill="currentColor" />
                        </svg>
                    </span>
                </div>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-md-12 mt-2 mb-4">
                        <label for="">Descripción</label>
                        <input name="descripcionFileDesc" id="descripcionFileDesc" class="form-control" value="" placeholder="Descripción del cargador" />
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-12 archivos dz-filename">
                        <!-- Campo de entrada de archivos -->
                        <input type="file" class="form-control-file" id="excelFile" required name="excelFile" onchange="updateFileNameDesc(this)">
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <!-- Botón de aceptar que llama a la función uploadExcel() -->
                <button type="button" class="btn btn-primary font-weight-bold" id="bt_ProcesarDescuentoCli" onclick="uploadExcelDesc()">Procesar</button>
                <button type="button" class="btn btn-danger font-weight-bold" data-dismiss="modal" onclick="closeUploadModalDesc()">Cerrar</button>
            </div>
        </div>
    </div>
</div>



<div class="modal fade" id="ModalDescuentoCinco" data-backdrop="static" tabindex="-1" role="dialog" aria-labelledby="staticBackdrop" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered " style="width:90% !important; max-width:90% !important; " role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Agregar a 5% de descuento</h5>
                <!--begin::Close-->
                <div class="btn btn-icon btn-sm btn-active-light-primary ms-2" data-bs-dismiss="modal" aria-label="Close">
                    <span class="svg-icon svg-icon-muted svg-icon-2x">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path opacity="0.3" d="M6 19.7C5.7 19.7 5.5 19.6 5.3 19.4C4.9 19 4.9 18.4 5.3 18L18 5.3C18.4 4.9 19 4.9 19.4 5.3C19.8 5.7 19.8 6.29999 19.4 6.69999L6.7 19.4C6.5 19.6 6.3 19.7 6 19.7Z" fill="currentColor" />
                            <path d="M18.8 19.7C18.5 19.7 18.3 19.6 18.1 19.4L5.40001 6.69999C5.00001 6.29999 5.00001 5.7 5.40001 5.3C5.80001 4.9 6.40001 4.9 6.80001 5.3L19.5 18C19.9 18.4 19.9 19 19.5 19.4C19.3 19.6 19 19.7 18.8 19.7Z" fill="currentColor" />
                        </svg>
                    </span>
                </div>
                <!--end::Close-->
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-md-6 mb-3 form-group">
                        <label>Cliente</label>
                        <select id="descCincoCliente" name="descClienteCinco" data-dropdown-parent="#ModalDescuentoCinco" class="form-select " data-control="select2" data-placeholder="Filtrar por cliente">
                            <option></option>
                            @{
                                if (ViewBag.ClienteDesc != null)
                                {
                                    foreach (var item in ViewBag.ClienteDesc)
                                    {
                                        <option value="@item.CLIENTE">@item.CLIENTE | @item.ALIAS</option>
                                    }
                                }
                            }
                        </select>
                    </div>
                    <div class="col-md-6 mb-3 form-group">
                        <label>Articulo</label>
                        <select id="descCincoArticulo" name="articulosDescCinco" data-dropdown-parent="#ModalDescuentoCinco" class="form-select" data-control="select2" data-placeholder="Filtrar por un artículo">
                            <option></option>
                            <option selected value="0">Todos</option>
                            @{
                                if (ViewBag.ArticuloDesc != null)
                                {
                                    foreach (var item in ViewBag.ArticuloDesc)
                                    {
                                        <option value="@item.ARTICULO">@item.ARTICULO | @item.DESCRIPCION</option>
                                    }
                                }
                            }
                        </select>
                    </div>
                    
                </div>
                <div class="col-md-12">
                    <div class="table-responsive">
                        <!--begin::Table-->
                        <table class="table align-middle table-row-dashed fs-6 gy-4" id="tabledesccinco">
                            <!--begin::Table head-->
                            <thead>
                                <!--begin::Table row-->
                                <tr class="text-start text-gray-600 fw-bold fs-7 text-uppercase gs-0">
                                    
                                    <th class="text-left min-w-200px">Artículo</th>
                                    <th class="text-left min-w-150px">Casa</th>
                                    <th class="text-left min-w-150px">SubCasa</th>
                                    <th class="text-left min-w-150px">Categoria Art.</th>
                                    <th class="min-w-100px" style="text-align:right">Desc temp.</th>
                                    <th class="min-w-100px" style="text-align:right">Fecha Inicio.</th>
                                    <th class="min-w-100px" style="text-align:right">Fecha Fin.</th>
                                </tr>
                                <!--end::Table row-->
                            </thead>
                            <!--end::Table head-->
                        </table>
                        <!--end::Table-->
                    </div>
                </div>
                

                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary font-weight-bold" data-bs-dismiss="modal">Cerrar</button>
                    <button type="button" onclick="guardarCincoDescuento();" class="btn btn-primary font-weight-bold" value="Default">Cargar a 5% descuento</button>
                </div>
            </div>
        </div>
    </div>
</div>
<!--begin::Engage-->
