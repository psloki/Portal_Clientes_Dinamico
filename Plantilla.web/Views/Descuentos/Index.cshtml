                <!--end::Card body-->
            </div>
            <!--end::Card-->
            <!--begin::Card-->
            <div class="card">
                <!--begin::Card body-->
                <div class="card-body pt-0">
                    <div class="table-responsive">
                        <!--begin::Table-->
                        <table class="table align-middle table-row-dashed fs-6 gy-4" id="miTabla">
                            <!--begin::Table head-->
                            <thead>
                                <!--begin::Table row-->
                                <tr class="text-start text-gray-600 fw-bold fs-7 text-uppercase gs-0">
                                    <th class="min-w-10px pe-2">
                                        <div class="form-check form-check-sm form-check-custom form-check-solid me-3">
                                            <input class="form-check-input" id="checkAll" type="checkbox" data-kt-check="true" data-kt-check-target="#miTabla .form-check-input" value="1" />
                                        </div>
                                    </th>

                                    @*<th class="text-left min-w-80px">Cat.Cliente</th>
                                        <th class="text-left min-w-200px ">Cliente</th>*@
                                    <th class="text-left min-w-100px ">Nivel precio</th>
                                    <th class="text-left min-w-200px">Artículo</th>
                                    <th class="text-left min-w-150px">Casa</th>
                                    <th class="text-left min-w-100px">SubCasa</th>
                                    <th class="text-left min-w-150px">Categoria Art</th>
                                    <th class="min-w-75px" style="text-align:right">Precio</th>
                                    <th class="min-w-100px" style="text-align:right">Desc. actual</th>
                                    <th class="text-left min-w-110px">Inicio actual</th>
                                    <th class="text-left min-w-110px">Fin actual</th>
                                    <th class="min-w-110px" style="text-align:right">Precio actual</th>
                                    <th class="min-w-130px" style="text-align:right">Desc. proy./anterior</th>
                                    <th class="text-left min-w-120px">Inicio UDF</th>
                                    <th class="text-left min-w-120px">Fin UDF</th>
                                    <th class="min-w-120px" style="text-align:right">Precio proyectado</th>
                                    <th class="text-left min-w-120px">Estado</th>
                                    <th class="text-left min-w-100px">Acciones</th>
                                    @*<th class="text-end"></th>*@
                                </tr>
                                <!--end::Table row-->
                            </thead>
                            <!--end::Table head-->
                        </table>
                        <!--end::Table-->
                    </div>

                </div>
                <!--end::Card body-->
            </div>
            <!--end::Card-->
        </div>
        <!--end::Content container-->
    </div>
    <!--end::Content-->
</div>
<!--end::Content wrapper-->


<div class="modal fade" id="ModalEdiDescuento" data-backdrop="static" tabindex="-1" role="dialog" aria-labelledby="staticBackdrop" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Editar Descuento</h5>
                <!--begin::Close-->
                <div class="btn btn-icon btn-sm btn-active-light-primary ms-2" data-bs-dismiss="modal" aria-label="Close">
                    <span class="svg-icon svg-icon-muted svg-icon-2x">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path opacity="0.3" d="M6 19.7C5.7 19.7 5.5 19.6 5.3 19.4C4.9 19 4.9 18.4 5.3 18L18 5.3C18.4 4.9 19 4.9 19.4 5.3C19.8 5.7 19.8 6.29999 19.4 6.69999L6.7 19.4C6.5 19.6 6.3 19.7 6 19.7Z" fill="currentColor" />
                            <path d="M18.8 19.7C18.5 19.7 18.3 19.6 18.1 19.4L5.40001 6.69999C5.00001 6.29999 5.00001 5.7 5.40001 5.3C5.80001 4.9 6.40001 4.9 6.80001 5.3L19.5 18C19.9 18.4 19.9 19 19.5 19.4C19.3 19.6 19 19.7 18.8 19.7Z" fill="currentColor" />
                        </svg>
                    </span>
                </div>
                <!--end::Close-->
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-md-6 mb-3 form-group">
                        <label>Nivel Precio</label>
                        <input disabled type="text" class="form-control" id="nivelPrecioDescuento" value="" />
                    </div>
                    <div class="col-md-6 mb-3 form-group">
                        <label>Artículo</label>
                        <input disabled type="text" class="form-control" id="ArticuloDescuento" value="" />
                    </div>
                    <div class="col-md-6 mb-3 form-group">
                        <label>Cantidad Min</label>
                        <input type="number" min="1" class="form-control" id="CantidadMin" value="1" />
                    </div>
                    <div class="col-md-6 mb-3 form-group">
                        <label>Cantidad Max</label>
                        <input type="number" min="1" class="form-control" id="CantidadMax" value="1" />
                    </div>
                </div>

                <div class="separator separator-dashed my-4"></div>
                <h6 class="text-gray-700 mb-3">Descuento actual</h6>
                <div class="row">
                    <div class="col-md-6 mb-3 form-group">
                        <label>Porcentaje actual</label>
                        <input disabled type="number" class="form-control" id="PorDescuentoActual" value="0" />
                    </div>
                    <div class="col-md-6 mb-3 form-group">
                        <label>Precio actual</label>
                        <input disabled type="text" class="form-control" id="PrecioActual" value="0" />
                    </div>
                    <div class="col-md-6 mb-3 form-group">
                        <label>Fecha inicio actual</label>
                        <input disabled type="text" class="form-control" id="fechaIniDescActual" value="" />
                    </div>
                    <div class="col-md-6 mb-3 form-group">
                        <label>Fecha final actual</label>
                        <input disabled type="text" class="form-control" id="fechaFinalDescActual" value="" />
                    </div>
                </div>

                <div class="separator separator-dashed my-4"></div>
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h6 class="text-gray-700 mb-0">Descuento proyectado</h6>
                    <span id="estadoProyeccionModal" class="badge badge-light-secondary">Sin proyección</span>
                </div>
                <div id="mensajeProyeccionActiva" class="alert alert-warning d-none py-3">
                    La proyección ya está activa. Los UDF contienen el descuento anterior y no deben modificarse hasta que el job lo restaure.
                </div>
                <div class="row">
                    <div class="col-md-6 mb-3 form-group">
                        <label>Porcentaje proyectado</label>
                        <input type="number" min="0" max="100" step="0.01" class="form-control" id="PorDescuentoProyectado" value="1" />
                    </div>
                    <div class="col-md-6 mb-3 form-group">
                        <label>Precio proyectado</label>
                        <input disabled type="text" class="form-control" id="PrecioProyectado" value="0" />
                    </div>
                    <div class="col-md-6 mb-3 form-group">
                        <label>Fecha inicio proyectada</label>
                        <input type="text" class="form-control" id="fechaIniDescProyectada" value="" />
                    </div>
                    <div class="col-md-6 mb-3 form-group">
                        <label>Fecha final proyectada</label>
                        <input type="text" class="form-control" id="fechaFinalDescProyectada" value="" />
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary font-weight-bold" data-bs-dismiss="modal">Cerrar</button>
                <button type="button" id="btnGuardarDescuento" onclick="guardarDescuento();" class="btn btn-primary font-weight-bold">Guardar</button>
            </div>
        </div>
    </div>
</div>
<div class="modal fade" id="ModalDescuento" data-backdrop="static" tabindex="-1" role="dialog" aria-labelledby="staticBackdrop" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Programar descuento masivo</h5>
                <!--begin::Close-->
                <div class="btn btn-icon btn-sm btn-active-light-primary ms-2" data-bs-dismiss="modal" aria-label="Close">
                    <span class="svg-icon svg-icon-muted svg-icon-2x">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none"
                             xmlns="http://www.w3.org/2000/svg">
                            <path opacity="0.3"
                                  d="M6 19.7C5.7 19.7 5.5 19.6 5.3 19.4C4.9 19 4.9 18.4 5.3 18L18 5.3C18.4 4.9 19 4.9 19.4 5.3C19.8 5.7 19.8 6.29999 19.4 6.69999L6.7 19.4C6.5 19.6 6.3 19.7 6 19.7Z"
                                  fill="currentColor" />
                            <path d="M18.8 19.7C18.5 19.7 18.3 19.6 18.1 19.4L5.40001 6.69999C5.00001 6.29999 5.00001 5.7 5.40001 5.3C5.80001 4.9 6.40001 4.9 6.80001 5.3L19.5 18C19.9 18.4 19.9 19 19.5 19.4C19.3 19.6 19 19.7 18.8 19.7Z"
                                  fill="currentColor" />
                        </svg>
                    </span>
                </div>
                <!--end::Close-->
            </div>

            <div class="modal-body">
                <div class="col-md-12 mb-3 form-group">
                    <label for="nivelPrecioDescuento">Nivel Precio</label>
                    <input disabled type="text" class="form-control" id="nivelPrecioDescuentoMultiple" value="" />
                </div>
                <div class="col-md-12 mb-3 form-group">
                    <label for="ArticuloDescuentoMasivo">Artículos</label>
                    <input disabled type="text" class="form-control" id="ArticuloDescuentoMultiple" value="" />
                </div>
                <div class="col-md-12 mb-3 form-group">
                    <label for="CantidadMinMasivo">Cantidad Min</label>
                    <input type="number" class="form-control" id="CantidadMinMasivo" value="1" />
                </div>
                <div class="col-md-12 mb-3 form-group">
                    <label for="CantidadMaxMasivo">Cantidad Max</label>
                    <input type="number" class="form-control" id="CantidadMaxMasivo" value="1" />
                </div>
                <div class="col-md-12 mb-3 form-group">
                    <label for="PorDescuentoMasivo">Porcentaje proyectado</label>
                    <input type="number" min="0" max="100" step="0.01" class="form-control" id="PorDescuentoMasivo" value="1" />
                </div>
                <div class="col-md-12 mb-3 form-group">
                    <label for="fechaIniDescMasivo">Fecha inicio proyectada</label>
                    <input type="text" class="form-control" id="fechaIniDescMasivo" value="" />
                </div>
                <div class="col-md-12 mb-3 form-group">
                    <label for="fechaFinalDescMasivo">Fecha final proyectada</label>
                    <input type="text" class="form-control" id="fechaFinalDescMasivo" value="" />
                </div>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-secondary font-weight-bold"
                        data-bs-dismiss="modal">
                    Cerrar
                </button>
                <button type="button" onclick="guardarDescuentoNivelMasivo();" class="btn btn-primary font-weight-bold">
                    Guardar
                </button>
            </div>
        </div>
    </div>
</div>


<div class="modal fade in" id="EdiModalDescuento" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true" data-backdrop="static" data-keyboard="false">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="fw-bold" id="ActualizarDescuento">Subir archivo</h2>
                <div class="btn btn-icon btn-sm btn-active-icon-primary" data-kt-roles-modal-action="close" onclick="closeUploadModalDesc();">
                    <span class="svg-icon svg-icon-1">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <rect opacity="0.5" x="6" y="17.3137" width="16" height="2" rx="1" transform="rotate(-45 6 17.3137)"
                                  fill="currentColor" />
                            <rect x="7.41422" y="6" width="16" height="2" rx="1" transform="rotate(45 7.41422 6)"
                                  fill="currentColor" />
                        </svg>
                    </span>
                </div>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-md-12 mt-2 mb-4">
                        <label for="">Descripción</label>
                        <input name="descripcionFileDesc" id="descripcionFileDesc" class="form-control" value="" placeholder="Archivo seleccionado" readonly />
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-12 archivos dz-filename">
                        <!-- Campo de entrada de archivos -->
                        <input type="file" class="form-control-file" id="excelFile" required name="excelFile" accept=".xlsx" onchange="updateFileNameDesc(this)">
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <!-- Botón de aceptar que llama a la función uploadExcel() -->
                <button type="button" class="btn btn-primary font-weight-bold" id="bt_ProcesarDescuento" onclick="uploadExcelDesc()">Procesar</button>
                <button type="button" class="btn btn-danger font-weight-bold" data-dismiss="modal" onclick="closeUploadModalDesc()">Cerrar</button>
            </div>
        </div>
    </div>
</div>

