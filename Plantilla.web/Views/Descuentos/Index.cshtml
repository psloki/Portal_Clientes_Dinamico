                                            }
                                        }
                                    }
                                </select>
                            </div>*@
                        <div class="form-group col-md-2 mt-3">
                            <label>Casa</label>
                            <select id="casaDesc" name="casaDesc" class="form-select filtro" data-control="select2" multiple data-placeholder="Filtrar por Casa">
                                <option></option>
                                <option selected value="0">Todas</option>
                                @{
                                    if (ViewBag.CasaArtDesc != null)
                                    {
                                        foreach (var item in ViewBag.CasaArtDesc)
                                        {
                                            <option value="@item.CLASIFICACION">@item.CLASIFICACION | @item.DESCRIPCION</option>
                                        }
                                    }
                                }
                            </select>
                        </div>
                        <div class="form-group col-md-2 mt-3">
                            <label>SubCasa</label>
                            <select id="SubCasaDesc" name="SubCasaDesc" class="form-select filtro" data-control="select2" multiple data-placeholder="Filtrar por subcasa">
                                <option></option>
                                <option selected value="0">Todas</option>
                                @{
                                    if (ViewBag.SubCasaArtDesc != null)
                                    {
                                        foreach (var item in ViewBag.SubCasaArtDesc)
                                        {
                                            <option value="@item.CLASIFICACION">@item.CLASIFICACION | @item.DESCRIPCION</option>
                                        }
                                    }
                                }
                            </select>
                        </div>

                        @*<div class="form-group col-md-2 mt-3">
                                <label>SubCasa</label>
                                <select id="SubCasaDesc" name="SubCasaDesc" class="form-select filtro" data-control="select2" multiple data-placeholder="Filtrar por SubCasa">
                                    <option></option>
                                    <option selected value="0">Todas</option>
                                    @{
                                        if (ViewBag.SubCasaArtDesc != null)
                                        {
                                            foreach (var item in ViewBag.SubCasaArtDesc)
                                            {
