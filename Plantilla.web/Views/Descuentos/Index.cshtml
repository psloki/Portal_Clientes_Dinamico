                        <div class="form-group col-md-2 mt-3">
                            <label>Artículo</label>
                            <select id="articulosDesc" name="articulosDesc" class="form-select" data-control="select2" data-placeholder="Filtrar por un artículo">
                                <option value="0" selected>Todos</option>
                            </select>
                        </div>


                        @*<div class="form-group col-md-2 mt-3">
                                <label>Categoría cliente</label>
                                <select id="categoriaDesc" name="categoriaDesc" class="form-select filtro" data-control="select2" data-placeholder="Filtrar por categoría">
