
@{
    ViewBag.Title = "Documentos Históricos";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<!--begin::Content wrapper-->
<div class="d-flex flex-column flex-column-fluid">

    <!--begin::Content-->
    <div id="kt_app_content" class="app-content flex-column-fluid">
        <!--begin::Content container-->
        <div id="kt_app_content_container" class="app-container container-xxl" style="max-width:100% !important">
            <!--begin::Toolbar-->
            <div id="kt_app_toolbar" class="app-toolbar py-3 py-lg-6">
                <!--begin::Page title-->
                <div class="page-title d-flex flex-column justify-content-center flex-wrap me-3">
                    <!--begin::Title-->
                    <h1 class="page-heading d-flex text-dark fw-bold fs-3 flex-column justify-content-center my-0">@ViewBag.Title</h1>
                    <!--end::Title-->
                </div>
                <!--end::Page title-->
            </div>
            <!--end::Toolbar-->
            <!--begin::Card-->
            <div class="card mb-6">
                <!--begin::Card body-->
                <div class="card-body pt-0">
                    <div class="row align-items-center mt-7">

                        <div class="form-group col-md-3 mb-4">
                            <label>Rango de fechas</label>
                            <input class="form-control filtro" placeholder="Pick date rage" id="FechaInicioV" value="@((new DateTime(DateTime.Now.Year, DateTime.Now.Month, 1).ToString("dd/MM/yyyy"))+ " - " + DateTime.Now.ToString("dd/MM/yyyy"))" />
                        </div>
                        <div class="col-md-3 mb-4">
                            <label>Documentos con saldo</label>
                            <select id="cobradorf" class="form-select" data-control="select2" data-placeholder="Filtrar" style="width:100%">
                                <option></option>
                                <option value="0">Todas</option>
                                <option selected value="Pendientes">Pendientes</option>
                                <option value="Cancelados">Cancelados</option>
                            </select>
                        </div>
                        <div class="col-md-3 mb-4">
                            <label>Tipo de documento</label>
                            <select id="tipodoc" class="form-select" data-control="select2" data-placeholder="Filtrar" style="width:100%" multiple>
                                <option></option>
                                <option selected value="0">Todos</option>
                                <option value="FAC">FAC</option>
                                <option value="REC">REC</option>
                                <option value="TEF">TEF</option>
                                <option value="N/C">N/C</option>
                                <option value="N/D">N/D</option>
                                <option value="O/C">O/C</option>
                                <option value="O/D">O/D</option>

                            </select>
                        </div>
                        <div class="col-md-3 mb-4">
                            <label>Forma de pago</label>
                            <select id="formapgo" class="form-select" data-control="select2" data-placeholder="Filtrar" style="width:100%" multiple>
                                <option></option>
                                <option value="Efectivo">Efectivo</option>
                                <option value="Sinpe móvil">Sinpe móvil</option>
                                <option value="Cheque">Cheque</option>
                                <option value="Cheque postfechado">Cheque postfechado</option>
                                <option value="Transferencia">Transferencia</option>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label>Depósito</label>
                            <select id="deposito" class="form-select" data-control="select2" data-placeholder="Filtrar" style="width:100%">
                                <option></option>
                                <option selected value="0">Todos</option>
                                <option value="DEP00015">DEP00015</option>
                                <option value="Pendiente">Pendiente</option>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label>Cobrador</label>
                            <select id="cobrador" class="form-select" data-control="select2" data-placeholder="Filtrar" style="width:100%">
                                <option></option>
                                <option selected value="0">Todos</option>
                                <option value="7024-ANA YANCY SALAS">7024-ANA YANCY SALAS</option>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label>Cliente</label>
                            <select id="ClienteDocHist" class="form-select" data-control="select2" data-placeholder="Filtrar" style="width:100%">
                                <option></option>
                                <option selected value="0">Todos</option>
                                <option value="7024-ANA YANCY SALAS">7024-ANA YANCY SALAS</option>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label>Vendedor</label>
                            <select id="VendedorDocHist" class="form-select" data-control="select2" data-placeholder="Filtrar" style="width:100%">
                                <option></option>
                                <option selected value="0">Todos</option>
                                <option value="7024-ANA YANCY SALAS">7024-ANA YANCY SALAS</option>
                            </select>
                        </div>
                        <div class="col-md-3 mt-6">
                            <div class="input-icon">
                                <input type="text" class="form-control" placeholder="Buscar..." id="kt_datatable_search_query" data-kt-docs-table-filter="search" autocomplete="off" />
                                <span>
                                    <i class="flaticon2-search-1 text-muted"></i>
                                </span>
                            </div>
                        </div>

                    </div>
                </div>
                <!--end::Card body-->
            </div>
            <!--end::Card-->
            <!--begin::Card-->
            <div class="card">
                <!--begin::Card body-->
                <div class="card-body pt-0">

                    <!--begin::Table-->
                    <table class="table align-middle table-row-dashed fs-6 gy-4" id="miTabla">
                        <!--begin::Table head-->
                        <thead>
                            <!--begin::Table row-->
                            <tr class="text-start text-gray-600 fw-bold fs-7 text-uppercase gs-0">

                                <th class="min-w-10px pe-2">
                                    <div class="form-check form-check-sm form-check-custom form-check-solid me-3">
                                        <input class="form-check-input" id="checkAll" type="checkbox" data-kt-check="true" data-kt-check-target="#miTabla .form-check-input" value="1" />
                                    </div>
                                </th>
                                <th class="text-left min-w-10px verSubtabla"></th>
                                <th class="text-left min-w-250px">Cliente</th>
                                <th class="text-left min-w-50px">Recibo</th>
                                <th class="text-left min-w-150px ">Documento</th>
                                <th class="text-left min-w-100px ">Estado</th>
                                <th class="text-left min-w-100px">Fecha rec</th>
                                <th class="text-left min-w-150px">Forma de pago</th>
                                <th class="text-left min-w-50px">TEF</th>
                                <th class="text-left min-w-100px ">Depósito</th>
                                <th class="text-left min-w-100px">Banco</th>
                                <th class="text-left min-w-50px">tef/dep</th>
                                <th class="text-left min-w-50px">Moneda</th>
                                <th class="text-left min-w-50px">Monto</th>
                                <th class="text-left min-w-200px">Cobrador</th>
                                <th class="text-left min-w-150px">Comentario tesorería</th>
                                <th class="text-left min-w-350px">Acciones</th>
                            </tr>
                            <!--end::Table row-->
                        </thead>
                        <!--end::Table head-->
                        <!--begin::Table body-->
                        <tbody class="fw-bold text-gray-600">
                        </tbody>
                        <!--end::Table body-->
                    </table>
                    <!--end::Table-->
                </div>
                <!--end::Card body-->
            </div>
            <!--end::Card-->
        </div>
        <!--end::Content container-->
    </div>
    <!--end::Content-->
</div>
<!--end::Content wrapper-->

<div class="modal fade" id="modalcorreos" data-backdrop="static" tabindex="-1" role="dialog" aria-labelledby="staticBackdrop" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Enviar comprobante por correos</h5>
                <!--begin::Close-->
                <div class="btn btn-icon btn-sm btn-active-light-primary ms-2" data-bs-dismiss="modal" aria-label="Close">
                    <span class="svg-icon svg-icon-muted svg-icon-2x">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path opacity="0.3" d="M6 19.7C5.7 19.7 5.5 19.6 5.3 19.4C4.9 19 4.9 18.4 5.3 18L18 5.3C18.4 4.9 19 4.9 19.4 5.3C19.8 5.7 19.8 6.29999 19.4 6.69999L6.7 19.4C6.5 19.6 6.3 19.7 6 19.7Z" fill="currentColor" />
                            <path d="M18.8 19.7C18.5 19.7 18.3 19.6 18.1 19.4L5.40001 6.69999C5.00001 6.29999 5.00001 5.7 5.40001 5.3C5.80001 4.9 6.40001 4.9 6.80001 5.3L19.5 18C19.9 18.4 19.9 19 19.5 19.4C19.3 19.6 19 19.7 18.8 19.7Z" fill="currentColor" />
                        </svg>
                    </span>
                </div>
                <!--end::Close-->
            </div>
            <div class="modal-body">

                <div class="col-md-12 mb-3">
                    <label>Correo de cuentas por pagar</label>
                    <input type="text" class="form-control form-control-solid" name="start" autocomplete="off" value="cxp@cliente.com" disabled />
                </div>
                <div class="col-md-12 mb-3">
                    <label>Correos opcionales</label>
                    <input type="text" class="form-control" name="start" autocomplete="off" value="cobrador@ancla.com" />
                </div>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-secondary font-weight-bold" data-bs-dismiss="modal">Cerrar</button>
                <button type="button" onclick="EnviarCorreo()" class="btn btn-primary font-weight-bold" value="Default">Enviar</button>
            </div>
        </div>
    </div>
</div>



