
@{
    ViewBag.Title = "Clientes";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@using System.Globalization
@{
    // Fecha de hoy, sin hora
    var hoy = DateTime.Today;
}
<!--begin::Content wrapper-->
<div class="d-flex flex-column flex-column-fluid">

    <!--begin::Content-->
    <div id="kt_app_content" class="app-content flex-column-fluid">
        <!--begin::Content container-->
        <div id="kt_app_content_container" class="app-container container-xxl" style="max-width:100% !important">
            <!--begin::Toolbar-->
            <div id="kt_app_toolbar" class="app-toolbar py-3 py-lg-6">
                <!--begin::Page title-->
                <div class="page-title d-flex flex-column justify-content-center flex-wrap me-3">
                    <!--begin::Title-->
                    <h1 class="page-heading d-flex text-dark fw-bold fs-3 flex-column justify-content-center my-0">@ViewBag.Title</h1>
                    <!--end::Title-->
                </div>
                <!--end::Page title-->
            </div>
            <!--end::Toolbar-->
            <!--begin::Card-->
            @{
                var forceMobileByQuery = string.Equals(Context.Request["mobile"], "1", StringComparison.OrdinalIgnoreCase);
                var userAgent = (Context.Request.Headers["User-Agent"] ?? string.Empty).ToLowerInvariant();
                var browserIsMobile = Context.Request.Browser != null && Context.Request.Browser.IsMobileDevice;
                var isMobile = forceMobileByQuery
                    || browserIsMobile
                    || userAgent.Contains("mobi")
                    || userAgent.Contains("android")
                    || userAgent.Contains("iphone")
                    || userAgent.Contains("ipad")
                    || userAgent.Contains("ipod")
                    || userAgent.Contains("tablet")
                    || userAgent.Contains("lenovo")
                    || userAgent.Contains("silk")
                    || userAgent.Contains("kindle");
            }
            <div class="card mb-6  ">
                <!--begin::Card body-->
                <div class="card-body pt-0">
                    <div class="row align-items-center mt-7">
                        <div class="form-group col-md-3 mt-3">
                            <label>Semana</label>
                            <select id="semana"
                                    name="semana"
                                    class="form-select filtro_multiple"
                                    data-control="select2"
                                    data-placeholder="Filtrar por semana"
                                    multiple>
                                <option value=""></option>
                                <option value="0">Todas</option>

                                @* Recorres tu ViewBag.Semana y marcas la opción cuya semana contenga “hoy” *@
                                @if (ViewBag.Semana != null)
                                {
                                    foreach (var item in ViewBag.Semana)
                                    {
                                        var inicio = DateTime.ParseExact(item.inicio_semana, "dd-MM-yyyy", CultureInfo.InvariantCulture);
                                        var fin = DateTime.ParseExact(item.fin_semana, "dd-MM-yyyy", CultureInfo.InvariantCulture);
                                        var esActual = (hoy >= inicio && hoy <= fin);

                                        <option value="@item.semana" @(esActual ? "selected" : "")>
                                            @item.Descripcion  |  @item.inicio_semana  |  @item.fin_semana
                                        </option>
                                    }
                                }
                            </select>
                        </div>

                        <div class="form-group col-md-3 mt-3">
                            <label>Día de la semana</label>
                            <select id="dia" name="dia" class="form-select filtro" data-control="select2" data-placeholder="Filtrar por día">
                                <option></option>
                                @*<option value="0">Todos</option>
                                 <option value="L" @((DateTime.Now.DayOfWeek == DayOfWeek.Monday) ? "selected" : "")>Lunes</option>
                                 <option value="K" @((DateTime.Now.DayOfWeek == DayOfWeek.Tuesday) ? "selected" : "")>Martes</option>
                                 <option value="M" @((DateTime.Now.DayOfWeek == DayOfWeek.Wednesday) ? "selected" : "")>Miércoles</option>
                                 <option value="J" @((DateTime.Now.DayOfWeek == DayOfWeek.Thursday) ? "selected" : "")>Jueves</option>
                                 <option value="V" @((DateTime.Now.DayOfWeek == DayOfWeek.Friday) ? "selected" : "")>Viernes</option>
                                 <option value="S" @((DateTime.Now.DayOfWeek == DayOfWeek.Saturday) ? "selected" : "")>Sábado</option>*@
                                <option selected value="0">Todos</option>
                                <option value="L">Lunes</option>
                                <option value="K">Martes</option>
                                <option value="M">Miercoles</option>
                                <option value="J">Jueves</option>
                                <option value="V">Viernes</option>
                                <option value="S">Sabado</option>
                            </select>
                        </div>
                        <div class="form-group col-md-3 mt-3">
                            <label>Saldo</label>
                            <select id="saldo" name="param" class="form-select filtro" data-control="select2" data-placeholder="Filtrar por saldo">
                                <option></option>
                                <option selected value="0">Todas</option>
                                <option value="1">Terminado</option>
                                <option value="2">Pendiente</option>
                            </select>
                        </div>
                        <div class="form-group col-md-3 mt-3">
                            <label>Condición de pago</label>
                            <select id="condpago" name="param" class="form-select filtro" data-control="select2" data-placeholder="Filtrar por condición de pago">
                                <option></option>
                                <option selected value="0">Todas</option>
                                @{
                                    if (ViewBag.Condicion_Pago != null)
                                    {
                                        foreach (var item in ViewBag.Condicion_Pago)
                                        {
                                            <option value="@item.CONDICION_PAGO">
                                                @(System.Text.RegularExpressions.Regex.Replace(
              item.DIAS_NETO ?? string.Empty,
              "(?i)dias",
              "Días"))
                                            </option>
                                        }
                                    }
                                }

                            </select>
                        </div>
                        <div class="form-group col-md-3 mt-3">
                            <label>Estado visita</label>
                            <select id="EstadoVisita" name="param" class="form-select filtro" data-control="select2" data-placeholder="Filtrar por condición de pago">
                                <option></option>
                                <option selected value="0">Todas</option>
                                @{
                                    if (ViewBag.EstadoVisita != null)
                                    {
                                        foreach (var item in ViewBag.EstadoVisita)
                                        {
                                            <option value="@item.ESTADO_VISITA">@item.DESCRIPCION </option>
                                        }
                                    }
                                }
                            </select>
                        </div>
                        <div class="col-md-3 mt-8">
                            <div class="input-icon">
                                <input type="text" class="form-control" placeholder="Buscar..." id="kt_datatable_search_query" data-kt-docs-table-filter="search" autocomplete="off" />
                                <span>
                                    <i class="flaticon2-search-1 text-muted"></i>
                                </span>
                            </div>
                        </div>

                    </div>
                </div>
                <!--end::Card body-->
            </div>
            <!--end::Card-->
            
            <!--begin::Card-->
            <div class="card">
                <!--begin::Card body-->
                <div class="card-body pt-0">
                    <div class="table-responsive">
                        <!--begin::Table-->
                        <table class="table align-middle table-row-dashed fs-6 gy-4" id="miTabla">
                            <!--begin::Table head-->
                            <thead>
                                <!--begin::Table row-->
                                <tr class="text-start text-gray-600 fw-bold fs-7 text-uppercase gs-0">

                                    <th class="min-w-10px pe-2">
                                        <div class="form-check form-check-sm form-check-custom form-check-solid me-3">
                                            <input class="form-check-input" id="checkAll" type="checkbox" data-kt-check="true" data-kt-check-target="#miTabla .form-check-input" />
                                        </div>
                                    </th>
                                    <th class="text-left min-w-15px verSubtabla"></th>
                                    <th class="text-left min-w-10px">E</th>
                                    <th class="text-left @(isMobile? "min-w-100px" : "min-w-200px")">Cliente</th>
                                    <th class="text-left min-w-150px">Alias</th>
                                    <th class="text-left min-w-50px ">Vendedor</th>
                                    <th class="text-left min-w-125px ">Correo</th>
                                    <th class="text-left min-w-125px ">Cobrador</th>
                                    <th class="text-left min-w-50px ">Teléfono</th>
                                    <th class="text-center min-w-25px">CNP</th>
                                    <th class="min-w-75px" style="text-align:right">Saldo</th>
                                    <th class="text-center min-w-25px">DV</th>
                                    <th class="text-left min-w-25px">IDV</th>
                                    <th class="text-left min-w-75px">Últ vis</th>
                                    <th class="text-left min-w-50px">Sem</th>
                                    <th class="text-left min-w-275px">Acciones</th>
                                    @*<th class="text-end"></th>*@
                                </tr>
                                <!--end::Table row-->
                            </thead>
                            <!--end::Table head-->
                            <!--begin::Table body-->
                            <tbody class="fw-bold text-gray-600">
                            </tbody>
                            <!--end::Table body-->
                        </table>
                        <!--end::Table-->
                    </div>
                    
                </div>

            </div>
            <!--end::Card body-->
        </div>
                <!--end::Card body-->
            </div>
            <!--end::Card-->
        </div>
        <!--end::Content container-->
    </div>
    <!--end::Content-->
</div>
<!--end::Content wrapper-->


<div class="modal fade" tabindex="-1" id="modalvisita">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h3 class="modal-title" id="labelvisita">Agregar nueva visita</h3>

                <!--begin::Close-->
                <div class="btn btn-icon btn-sm btn-active-light-primary ms-2" data-bs-dismiss="modal" aria-label="Close">
                    <span class="svg-icon svg-icon-muted svg-icon-2x">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path opacity="0.3" d="M6 19.7C5.7 19.7 5.5 19.6 5.3 19.4C4.9 19 4.9 18.4 5.3 18L18 5.3C18.4 4.9 19 4.9 19.4 5.3C19.8 5.7 19.8 6.29999 19.4 6.69999L6.7 19.4C6.5 19.6 6.3 19.7 6 19.7Z" fill="currentColor" />
                            <path d="M18.8 19.7C18.5 19.7 18.3 19.6 18.1 19.4L5.40001 6.69999C5.00001 6.29999 5.00001 5.7 5.40001 5.3C5.80001 4.9 6.40001 4.9 6.80001 5.3L19.5 18C19.9 18.4 19.9 19 19.5 19.4C19.3 19.6 19 19.7 18.8 19.7Z" fill="currentColor" />
                        </svg>
                    </span>
                </div>
                <!--end::Close-->
            </div>

            <div class="modal-body">
                <div class="row">
                    <div class="col-6">
                        <div class="form-group mb-6">
                            <label>Cliente</label>
                            <input id="clientevisita"
                                   type="text"
                                   class="form-control text-gray-500"
                                   style="font-size:0.90rem;"
                                   value=""
                                   disabled />
                        </div>

                        <div class="form-group mb-6">
                            <label>Tipo de visita</label>
                            <select id="tipovisita" name="tipovisita" class="form-select" data-control="select2" data-placeholder="Seleccione un tipo">
                                <option></option>

                                @if (ViewBag.TipoVisita != null)
                                {
                                    foreach (var item in ViewBag.TipoVisita)
                                    {
                                        <option value="@item.U_CODIGO">@item.U_DESCRIP</option>
                                    }
                                }
                            </select>
                        </div>

                        <div class="form-group mb-5">
                            <label>Comentarios</label>
                            <textarea class="form-control text-gray-500" rows="1" placeholder="Ingrese un comentario" id="comentariovisita"></textarea>
                        </div>
                        <div class="form-group mb-6">
                            <label>Documentos vencidos</label>
                            <textarea disabled type="text" class="form-control text-danger" rows="1" style="font-size:0.90rem;" id="Doc_Vencido"></textarea>
                        </div>

                        <div class="form-group mb-6">
                            <label>Cobrador</label>
                            <input id="cobradorVisita" type="text" class="form-control text-gray-500" style="font-size:0.90rem;" value="" disabled />
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="form-group mb-6">
                            <label>Fecha visita</label>
                            <input id="fechavisita" disabled type="text" class="form-control text-gray-500" style="font-size:0.90rem;" value="@(DateTime.Now.ToString("dd/MM/yyyy hh:mm:ss tt"))" />
                        </div>
                        <div class="form-group mb-6">
                            <label>Latitud</label>
                            <input id="latitudvisita" disabled type="text" class="form-control text-gray-500" style="font-size:0.90rem;" value="" />
                        </div>
                        <div class="form-group mb-6">
                            <label>Longitud</label>
                            <input id="longitudvisita" disabled type="text" class="form-control text-gray-500" style="font-size:0.90rem;" value="" />
                        </div>

                        <div class="form-group mb-6">
                            <label>Usuario</label>
                            <input id="usuariovisita" disabled type="text" class="form-control text-gray-500" style="font-size:0.90rem;" value="@Session["Usuario"].ToString()" />
                        </div>
                        <div class="form-group mb-6">
                            <label>Fecha creación</label>
                            <input id="fechavisitacreacion" disabled type="text" class="form-control text-gray-500" style="font-size:0.90rem;" value="@(DateTime.Now.ToString("dd/MM/yyyy"))" />
                        </div>
                    </div>


                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancelar</button>
                @*<a href="@Url.Content("~/RegistroPagos")" target="_blank" class="btn btn-primary">Pagos</a>*@

                @*@if (Array.IndexOf(Session["PERMISOS_GESTION_DE_PEDIDOS"].ToString().Split(','), "28") != -1)
                    {*@
                <button type="button" id="Pagos" class="btn btn-primary">Pagos</button>
                @*}
                    @if (Array.IndexOf(Session["PERMISOS_GESTION_DE_PEDIDOS"].ToString().Split(','), "28") != -1)
                    {*@
                <button type="button" id="deleteButton" onclick="guardarVisita();" class="btn btn-success">Pedido</button>

            </div>
        </div>
    </div>
</div>

@*++++++++++++++++++++++++++++++++++++++++++++++++MODAL Emvio de correo estado cuenta ++++++++++++++++++++++++++++++++++++++++++++++++++++++*@
