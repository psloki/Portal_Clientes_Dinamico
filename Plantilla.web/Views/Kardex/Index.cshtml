
@{
    ViewBag.Title = "Kardex 360";
    ViewBag.TitleHead = "Kardex 360";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<!--begin::Content wrapper-->
<div class="d-flex flex-column flex-column-fluid">

    <!--begin::Content-->
    <div id="kt_app_content" class="app-content flex-column-fluid">
        <!--begin::Content container-->
        <div id="kt_app_content_container" class="app-container container-xxl" style="max-width:100% !important">
            <!--begin::Toolbar-->
            <div id="kt_app_toolbar" class="app-toolbar py-3 py-lg-6">
                <!--begin::Page title-->
                <div class="page-title d-flex flex-column justify-content-center flex-wrap me-3">
                    <!--begin::Title-->
                    <h1 class="page-heading d-flex text-dark fw-bold fs-3 flex-column justify-content-center my-0">@ViewBag.Title</h1>
                    <!--end::Title-->
                </div>
                <!--end::Page title-->
            </div>
            <!--end::Toolbar-->
            <!--begin::Card-->
            <div class="card mb-6">
                <!--begin::Card body-->
                <div class="card-body pt-0">
                    <div class="row align-items-center mt-7">
                        <div class="form-group col-md-3 mb-3">
                            <label>Buscar por rango de fecha hasta</label>
                            <div class="d-flex align-items-center mb-3">
                                <input class="form-control filtro" placeholder="Pick date rage" id="FechaInicio"
                                       value="@((new DateTime(DateTime.Now.Year, DateTime.Now.Month, 1).ToString("dd/MM/yyyy")) + " - " + DateTime.Now.ToString("dd/MM/yyyy"))" />
                                @*value="@((DateTime.Now.AddDays(-5).ToString("dd/MM/yyyy"))+ " - " + new DateTime(DateTime.Now.Year, DateTime.Now.Month, 1).AddMonths(1).AddDays(-1).ToString("dd/MM/yyyy"))" />*@
                            </div>
                        </div>
                        <div class="form-group mb-3 col-md-3">
                            <label>Cliente</label>
                            <select id="cliente_cxc"
                                    class="form-select"
                                    data-control="select2"
                                    data-placeholder="Filtrar por cliente"
                                    style="width:100%">
                                <option value="0" selected>Todos</option>
                                @{
                                    if (ViewBag.Clientes != null)
                                    {
                                        foreach (var item in ViewBag.Clientes)
                                        {
                                            <option value="@item.CLIENTE">@item.CLIENTE - @item.ALIAS</option>
                                        }
                                    }
                                }
                            </select>

                        </div>
                        <div class="form-group mb-3 col-md-3 d-none">
                            <label>Tipo</label>
                            <select id="FiltroTipo" class="form-control" data-control="select2" data-placeholder="Seleccione una opción">
                                <option value="0">Todos</option>
                                @if (ViewBag.Tipo != null)
                                {
                                    foreach (var item in ViewBag.Tipo)
                                    {
                                        string selected = item.TIPO == "V" ? "selected" : "";

                                        <option value="@item.TIPO" @selected> @item.TIPO - @item.DESCRIPCION</option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="form-group mb-3 col-md-3">
                            <label>Bodega</label>
                            <select id="FiltroBodega" class="form-control" data-control="select2" data-placeholder="Seleccione una opción">
                                <option></option>
                                <option value="0">Todas</option>
                                @if (ViewBag.Bodegas != null)
                                {
                                    foreach (var item in ViewBag.Bodegas)
                                    {
                                        <option value="@item.BODEGA"> @item.BODEGA - @item.NOMBRE</option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="form-group mb-3 col-md-3">
                            <label>Artículo</label>
                            <select id="FiltroArticulo" class="form-control" data-control="select2" data-placeholder="Seleccione una opción">
                                <option></option>
                                <option value="0">Todos</option>
                                @if (ViewBag.Articulos != null)
                                {
                                    foreach (var item in ViewBag.Articulos)
                                    {
                                        <option value="@item.ARTICULO"> @item.COMPLETO</option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="form-group mb-3 col-md-3">
                            <label for="FiltroBuscar">Búsqueda</label>
                            <div class="input-icon">
                                <input type="text" class="form-control" placeholder="Buscar..." id="kt_datatable_search_query" autocomplete="off" />
                                <span>
                                    <i class="flaticon2-search-1 text-muted"></i>
                                </span>
                            </div>
                        </div>

                    </div>
                </div>
                <!--end::Card body-->
            </div>
            <!--end::Card-->
            <!--begin::Card-->
            <div class="card">
                <!--begin::Card body-->
                <div class="card-body pt-0">
                    <div class="table-responsive">
                        <!--begin::Table-->
                        <table class="table align-middle table-row-dashed fs-6 gy-4" id="kt_datatable">
                            <!--begin::Table head-->
                            <thead>
                                <!--begin::Table row-->
                                <tr class="text-start text-gray-600 fw-bold fs-7 text-uppercase gs-0">

                                    <th class="text-left min-w-0px"></th>
                                    <th class="text-left min-w-25px ">ID</th>
                                    <th class="text-left min-w-125px">ARTÍCULO</th>
                                    <th class="text-left min-w-125px">FECHA</th>
                                    <th class="text-left min-w-125px">APLICACION</th>
                                    <th class="text-left min-w-50px">TIPO</th>
                                    <th class="text-left min-w-50px">NATURALEZA</th>
                                    <th class="text-left min-w-125px">ASIENTO</th>
                                    <th class="text-left min-w-125px">REFERENCIA</th>
                                    <th class="text-left min-w-125px">CLIENTE</th>
                                    <th class="text-left min-w-50px">BODEGA</th>
                                    <th class="text-left min-w-50px">CANTIDAD</th>
                                    @*<th class="text-left min-w-50px">COSTO</th>*@
                                    <th class="text-left min-w-50px">PRECIO</th>

                                </tr>
                                <!--end::Table row-->
                            </thead>
                            <!--end::Table head-->
                            <!--begin::Table body-->
                            <tbody class="fw-bold text-gray-600">
                            </tbody>
                            <!--end::Table body-->
                        </table>
                        <!--end::Table-->
                    </div>

                </div>
                <!--end::Card body-->
            </div>
            <!--end::Card-->
        </div>
        <!--end::Content container-->
    </div>
    <!--end::Content-->
</div>
<!--end::Content wrapper-->

<div id="kardex-loading-overlay" class="d-none">
    <div class="kardex-loading-content">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Cargando...</span>
        </div>
        <div class="mt-3 fw-semibold">Cargando datos de Kardex...</div>
    </div>
</div>

<style>
    #kardex-loading-overlay {
        position: fixed;
        inset: 0;
        background: rgba(255, 255, 255, 0.72);
        backdrop-filter: blur(1px);
        z-index: 2000;
        align-items: center;
        justify-content: center;
    }

    #kardex-loading-overlay:not(.d-none) {
        display: flex !important;
    }

    .kardex-loading-content {
        text-align: center;
        color: #1f2937;
    }
</style>

<div class="app-engage" id="kt_app_engage">

    <a href="javascript:;" class="app-engage-btn hover-primary" onclick="scrollToTableRight()">
        <span class="svg-icon svg-icon-1 pt-1 mb-2">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path opacity="0.5" d="M9.63433 11.4343L5.45001 7.25C5.0358 6.83579 5.0358 6.16421 5.45001 5.75C5.86423 5.33579 6.5358 5.33579 6.95001 5.75L12.4929 11.2929C12.8834 11.6834 12.8834 12.3166 12.4929 12.7071L6.95001 18.25C6.5358 18.6642 5.86423 18.6642 5.45001 18.25C5.0358 17.8358 5.0358 17.1642 5.45001 16.75L9.63433 12.5657C9.94675 12.2533 9.94675 11.7467 9.63433 11.4343Z" fill="currentColor" />
                <path d="M15.6343 11.4343L11.45 7.25C11.0358 6.83579 11.0358 6.16421 11.45 5.75C11.8642 5.33579 12.5358 5.33579 12.95 5.75L18.4929 11.2929C18.8834 11.6834 18.8834 12.3166 18.4929 12.7071L12.95 18.25C12.5358 18.6642 11.8642 18.6642 11.45 18.25C11.0358 17.8358 11.0358 17.1642 11.45 16.75L15.6343 12.5657C15.9467 12.2533 15.9467 11.7467 15.6343 11.4343Z" fill="currentColor" />
            </svg>
        </span>
        Derecha
    </a>
    <a href="javascript:;" class="app-engage-btn hover-primary" onclick="scrollToTableLeft()">
        <span class="svg-icon svg-icon-1 pt-1 mb-2">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path opacity="0.5" d="M14.2657 11.4343L18.45 7.25C18.8642 6.83579 18.8642 6.16421 18.45 5.75C18.0358 5.33579 17.3642 5.33579 16.95 5.75L11.4071 11.2929C11.0166 11.6834 11.0166 12.3166 11.4071 12.7071L16.95 18.25C17.3642 18.6642 18.0358 18.6642 18.45 18.25C18.8642 17.8358 18.8642 17.1642 18.45 16.75L14.2657 12.5657C13.9533 12.2533 13.9533 11.7467 14.2657 11.4343Z" fill="currentColor" />
                <path d="M8.2657 11.4343L12.45 7.25C12.8642 6.83579 12.8642 6.16421 12.45 5.75C12.0358 5.33579 11.3642 5.33579 10.95 5.75L5.40712 11.2929C5.01659 11.6834 5.01659 12.3166 5.40712 12.7071L10.95 18.25C11.3642 18.6642 12.0358 18.6642 12.45 18.25C12.8642 17.8358 12.8642 17.1642 12.45 16.75L8.2657 12.5657C7.95328 12.2533 7.95328 11.7467 8.2657 11.4343Z" fill="currentColor" />
            </svg>
        </span>
        Izquierda
    </a>
</div>

<script>
    const KARDEX_URL = '@Url.Content("~/Kardex")'
</script>
@Scripts.Render(System.Web.Optimization.BundleTable.Bundles.ResolveBundleUrl("~/bundles/KardexIndex", true))
