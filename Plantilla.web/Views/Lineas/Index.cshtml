
@{
    ViewBag.Title = "Líneas de solicitud";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!--begin::Content wrapper-->
<div class="d-flex flex-column flex-column-fluid">

    <!--begin::Content-->
    <div id="kt_app_content" class="app-content flex-column-fluid">
        <!--begin::Content container-->
        <div id="kt_app_content_container" class="app-container container-xxl" style="max-width:100% !important">
            <!--begin::Toolbar-->
            <div id="kt_app_toolbar" class="app-toolbar py-3 py-lg-6">
                <!--begin::Page title-->
                <div class="page-title d-flex flex-column justify-content-center flex-wrap me-3">
                    <!--begin::Title-->
                    <h1 class="page-heading d-flex text-dark fw-bold fs-3 flex-column justify-content-center my-0">@ViewBag.Title</h1>
                    <!--end::Title-->
                </div>
                <!--end::Page title-->
            </div>
            <!--end::Toolbar-->
            <!--begin::Card-->
            <div class="card mb-6">
                <!--begin::Card body-->
                <div class="card-body pt-0">

                    <div class="row align-items-center mt-7">
                        <div class="form-group col-md-3 mt-3">
                            <label>Rango de fechas</label>
                            <input class="form-control " placeholder="Pick date rage" id="kt_daterangepicker_1" />
                        </div>
                        <div class="form-group col-md-2 mt-3">
                            <label>Solicitud</label>
                            <select id="solicitud" class="form-select" data-control="select2" style="width:100%" data-placeholder="Filtrar por solicitud">
                                <option></option>
                                <option selected value="0">Todas</option>
                                <option value="SOLI-20030">SOLI-20030</option>
                                <option value="SOLI-20032">SOLI-20032</option>
                                <option value="SOLI-20033">SOLI-20033</option>
                            </select>
                        </div>
                        <div class="form-group col-md-2 mt-3">
                            <label>Estado</label>
                            <select id="estado"  class="form-select" data-control="select2" style="width:100%" data-placeholder="Filtrar por estado">
                                <option></option>
                                <option selected value="0">Todos</option>
                                <option value="Aprobada">Aprobada</option>
                                <option value="Rev Proyecto">Revisada Proyecto</option>
                                <option value="Revisada CEDI">Revisada CEDI</option>
                                <option value="En compra">En compra</option>
                                <option value="Finalizada">Finalizada</option>
                                <option value="Cancelada">Cancelada</option>

                            </select>
                        </div>
                        <div class="form-group col-md-2 mt-3">
                            <label>Artículo</label>
                            <select id="articulo"  class="form-select" data-control="select2" style="width:100%" data-placeholder="Filtrar por artículo">
                                <option></option>
                                <option selected value="0">Todas</option>
                                <option value="71-0241 CUBRE ZAPATOS (*)">71-0241 CUBRE ZAPATOS (*)</option>
                                <option value="88-0004 GRABADOR ">88-0004 GRABADOR </option>
                                <option value="88-0004 UPS ">88-0004 UPS </option>
                                <option value="88-0004 SIRENA ">88-0004 SIRENA </option>
                                <option value="88-0004 TABLERO ">88-0004 TABLERO </option>
                                <option value="88-0004 SENSOR ">88-0004 SENSOR </option>
                                <option value="88-0004 BOTONERA ">88-0004 BOTONERA </option>
                                <option value="88-0018 CAMARA">88-0018 CAMARA</option>
                                <option value="AF-9-001-0 EXTINTOR">AF-9-001-0 EXTINTOR</option>
                                <option value="88-0001 Traslado de contenedores de taller de incendio">88-0001 Traslado de contenedores de taller de incendio</option>
                                <option value="AF-3-036-1 JUEGO MANUAL TROQUELES DE 1/2">AF-3-036-1 JUEGO MANUAL TROQUELES DE 1/2"</option>
                                <option value="14-0833 REFLECTOR HALOGENO 65BR30/FL 65W, 120V">14-0833 REFLECTOR HALOGENO 65BR30/FL 65W, 120V</option>
                                <option value="14-0996 TUBO HALOGENO 500W 110V (*)">14-0996 TUBO HALOGENO 500W 110V (*)</option>
                                <option value="31-0212 ROTULOS BAQUELITA">31-0212 ROTULOS BAQUELITA</option>
                                <option value="03-0385 TINTA HP CZ129A NEGRA P/T120 #711">03-0385 TINTA HP CZ129A NEGRA P/T120 #711</option>
                                <option value="03-0386 TINTA HP CZ130A CYAN P/T120 #711">03-0386 TINTA HP CZ130A CYAN P/T120 #711</option>
                                <option value="03-0387 TINTA HP CZ131A MAGENTA P/T120 #711">03-0387 TINTA HP CZ131A MAGENTA P/T120 #711</option>
                                <option value="03-0388 TINTA HP CZ132A YELLOW P/T120 #711">03-0388 TINTA HP CZ132A YELLOW P/T120 #711</option>
                                <option value="88-0004 MEDIDORA DE CABLE ">88-0004 MEDIDORA DE CABLE </option>
                                <option value="05-0045 CODO SANITARIO PVC 75MM X 90* P.G.">05-0045 CODO SANITARIO PVC 75MM X 90* P.G.</option>
                                <option value="70-0182 CABLE TIPO MC THHN 3#12 AWG UL (*)">70-0182 CABLE TIPO MC THHN 3#12 AWG UL (*)</option>
                                <option value="54-0035 GAZA DE COBRE TIPO LAZO 2/0 (121A DE IPC) (*)">54-0035 GAZA DE COBRE TIPO LAZO 2/0 (121A DE IPC) (*)</option>
                                <option value="03-0411 TINTA HP 667 NEGRO (3YM79AL) (*)">03-0411 TINTA HP 667 NEGRO (3YM79AL) (*)</option>
                                <option value="03-0412 TINTA HP 667 TRICOLOR (3YM78AL) (*)">03-0412 TINTA HP 667 TRICOLOR (3YM78AL) (*)</option>
                                <option value="10-0847 AMARRA PLASTICA BLANCA 12">10-0847 AMARRA PLASTICA BLANCA 12"</option>
                                <option value="10-0806 AMARRA PLASTICA BLANCA 24">10-0806 AMARRA PLASTICA BLANCA 24"</option>
                                <option value="49-0027 UNION IMC 25MM ROSCADA">49-0027 UNION IMC 25MM ROSCADA</option>
                                <option value="01-0081 CONECTOR BX RECTO EMT 38MM UL">01-0081 CONECTOR BX RECTO EMT 38MM UL</option>
                            </select>
                        </div>
                        <div class="form-group col-md-2 mt-3">
                            <label>Último alistó</label>
                            <select class="form-select" data-control="select2"  id="alisto" style="width:100%" data-placeholder="Filtrar por último alistó">
                                <option></option>
                                <option selected value="0">Todos</option>
                                <option value="Juan">Juan</option>
                                <option value="Carlos">Carlos</option>
                                <option value="Daniel">Daniel</option>
                            </select>
                        </div>
                        <div class="form-group col-md-8 mt-3">
                            <label>Bodega proyecto</label>
                            <select class="form-select" data-control="select2"  id="kt_select2_9" name="param" multiple="multiple" style="width:100%" data-placeholder="Filtrar por bodega">
                                <option></option>

                                <option selected value="PT01 CEDI PUNTARENAS">PT01 CEDI PUNTARENAS</option>
                                <option value="443G">443G Exteriores </option>
                                <option value="443H">443H Servicio </option>

                            </select>
                        </div>
                        <div class="col-md-3 mt-8">
                            <div class="input-icon">
                                <input type="text" class="form-control" placeholder="Buscar..." id="kt_datatable_search_query" data-kt-docs-table-filter="search" autocomplete="off" />
                                <span>
                                    <i class="flaticon2-search-1 text-muted"></i>
                                </span>
                            </div>
                        </div>
                        <div class="col-md-6 mt-8 multi d-flex justify-content-start align-items-center d-none" data-kt-subscription-table-toolbar="selected">
                            <div class="fw-bold me-5">
                                <span class="me-2" id="cantselect"></span>Seleccionados
                            </div>
                            <button type="button" class="btn btn-primary me-3" data-kt-subscription-table-select="delete_selected">Enviar a Softland ERP</button>
                            <button type="button" class="btn btn-success me-3" data-kt-subscription-table-select="delete_selected">Crear pedido</button>
                            <button type="button" class="btn btn-danger" data-kt-subscription-table-select="delete_selected">Enviar a desecho</button>
                        </div>
                    </div>
                </div>
                <!--end::Card body-->
            </div>
            <!--end::Card-->
            <!--begin::Card-->
            <div class="card">
                <!--begin::Card body-->
                <div class="card-body pt-0">

                    <!--begin::Table-->
                    <table class="table align-middle table-row-dashed fs-6 gy-4" id="miTabla">
                        <!--begin::Table head-->
                        <thead>
                            <!--begin::Table row-->
                            <tr class="text-start text-gray-600 fw-bold fs-7 text-uppercase gs-0">

                                @*<th class="min-w-100px">Order ID</th>*@
                                <th class="w-10px pe-2">
                                    <div class="form-check form-check-sm form-check-custom form-check-solid me-3">
                                        <input class="form-check-input" type="checkbox" data-kt-check="true" data-kt-check-target="#miTabla .form-check-input" value="1" />
                                    </div>
                                </th>
                                <th class="text-left min-w-10px verSubtabla"></th>
                                <th class="text-left min-w-100px">Solicitud</th>
                                <th class="text-left min-w-100px">Ult alistó</th>
                                <th class="text-left min-w-200px">Bodega</th>
                                <th class="text-left min-w-200px">Artículo</th>
                                <th class="text-left min-w-100px">Requerida</th>
                                <th class="text-left min-w-150px">Estado</th>
                                <th class="text-left min-w-75px">Solici</th>
                                <th class="text-left min-w-75px">Pendien</th>
                                <th class="text-left min-w-75px">Consumo</th>
                                <th class="text-left min-w-75px">Compra</th>
                                <th class="text-left min-w-350px">Acciones</th>
                                @*<th class="text-end"></th>*@
                            </tr>
                            <!--end::Table row-->
                        </thead>
                        <!--end::Table head-->
                        <!--begin::Table body-->
                        <tbody class="fw-bold text-gray-600">
                        </tbody>
                        <!--end::Table body-->
                    </table>
                    <!--end::Table-->
                </div>
                <!--end::Card body-->
            </div>
            <!--end::Card-->
        </div>
        <!--end::Content container-->
    </div>
    <!--end::Content-->
</div>
<!--end::Content wrapper-->

<!--begin::Engage-->
<div class="app-engage" id="kt_app_engage">
    <!--begin::Get help-->
    <a href="javascript:;" class="app-engage-btn hover-primary" onclick="scrollToTableRight()">
        <!--begin::Svg Icon | path: icons/duotune/general/gen063.svg-->
