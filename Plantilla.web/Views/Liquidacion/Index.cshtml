                    </div>

                    <div class="form-group mb-6">
                        <label>Tipo *</label>
                        <select id="tipo_cxc" disabled data-dropdown-parent="#agregarRef" name="tipo_cxc" class="form-select" data-control="select2" data-placeholder="Seleccione un tipo">
                            <option></option>
                            @*<option selected value="TEF">TEF</option>*@
                            <option selected value="DEP">DEP</option>


                        </select>
                    </div>
                    <div class="form-group mb-6">
                        <label>Subtipo *</label>
                        <select id="subtipo_cxc" disabled data-dropdown-parent="#agregarRef" name="tipo_cxc" class="form-select" data-control="select2" data-placeholder="Seleccione un subtipo">
                            <option></option>

                            <option selected value="0">1 || Liquidacion Efectivo</option>
                            @*<option selected value="0">0 || T.E.F.</option>*@

                        </select>
                    </div>
                    <div class="form-group mb-6">
                        <label>Cliente</label>
                        <input type="text" class="form-control" id="cliente_cxc" value="" disabled />
                    </div>
                    <div class="form-group mb-6">
                        <label>Concepto</label>
                        <input type="text" class="form-control" id="concepto_cxc" value="" />
                    </div>

                    <div class="form-group mb-6">
                        <label>Fecha</label>
                        <input type="text" class="form-control" id="fechadoc_cxc" value="" disabled />
                    </div>
                    <div class="form-group mb-6">
                        <label>Moneda</label>
                        <input type="text" class="form-control" id="moneda_cxc" value="" disabled />
                    </div>
                    <div class="form-group mb-6">
                        <label>Monto</label>
                        <input type="number" class="form-control" id="monto_cxc" value="" min="0" readonly />
                    </div>
                    <div class="form-group mb-6 d-none">
                        <label>Documento</label>
                        <input type="text" class="form-control" id="documento_cxc" value="" />
                    </div>
                    <div class="form-group mb-6 d-none">
                        <label>ID</label>
                        <input type="text" class="form-control" id="idlinea_cxc" value="" />
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" onclick="GuardarAsignarCC()" class="btn btn-success">Asignar Recibos</button>
            </div>
        </div>
    </div>
</div>



