<div class="modal fade" id="CrearTefModal" data-backdrop="static" tabindex="-1" role="dialog" aria-labelledby="staticBackdrop" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-xl" role="document">
        <div class="modal-content">

            <!-- ===== Header ===== -->
            <div class="modal-header">
                <h5 class="modal-title">Crear depósito</h5>
                <button type="button" class="btn btn-icon btn-sm btn-active-light-primary ms-2" data-bs-dismiss="modal" aria-label="Close">
                    <span class="svg-icon svg-icon-muted svg-icon-2x">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path opacity="0.3" d="M6 19.7C5.7 19.7 5.5 19.6 5.3 19.4C4.9 19 4.9 18.4 5.3 18L18 5.3C18.4 4.9 19 4.9 19.4 5.3C19.8 5.7 19.8 6.29999 19.4 6.69999L6.7 19.4C6.5 19.6 6.3 19.7 6 19.7Z" fill="currentColor" />
                            <path d="M18.8 19.7C18.5 19.7 18.3 19.6 18.1 19.4L5.40001 6.69999C5.00001 6.29999 5.00001 5.7 5.40001 5.3C5.80001 4.9 6.40001 4.9 6.80001 5.3L19.5 18C19.9 18.4 19.9 19 19.5 19.4C19.3 19.6 19 19.7 18.8 19.7Z" fill="currentColor" />
                        </svg>
                    </span>
                </button>
            </div>

            <!-- ===== Body ===== -->
            <div class="modal-body">
                <div class="container-fluid">

                    <input type="hidden" id="clienteModalHidden">
                    <input type="hidden" id="docIdsHidden">

                    <!-- ===== Fila 1: Moneda + Monto + Banco + #Referencia + Fecha ===== -->
                    <div class="row g-3">

                        <div class="col-12 col-md-1">
                            <label>Moneda</label>
                            <input disabled type="text" class="form-control" id="moneda" value="CRC" />
                        </div>

                        <div class="col-12 col-md-2">
                            <label>Monto seleccionado</label>
                            <input type="text" class="form-control" id="TotalMontoSeleccionado" value="₡0.00" disabled />
                        </div>

                        <div class="col-12 col-md-4">
                            <label>Banco</label>
                            <select id="bancoliquidacion" name="bancoliquidacion" class="form-select" data-dropdown-parent="#CrearTefModal" data-control="select2" data-placeholder="Filtrar">
                                <option></option>
                                <option selected value="0">Todos</option>
                                @if (ViewBag.Bancos != null)
                                {
                                    foreach (var item in ViewBag.Bancos)
                                    {
                                        <option value="@item.BANCO" data-cuenta="@item.CUENTA_BANCO">@item.BANCO - @item.NOMBRE</option>
                                    }
                                }
                            </select>
                        </div>

                        <div class="col-12 col-md-2">
                            <label># Referencia</label>
                            <input type="number" class="form-control" id="numtefr" />
                        </div>

                        <div class="col-12 col-md-3">
                            <label>Fecha</label>
                            <input id="FechaInicio2Seguimiento" type="text" class="form-control fecha text-gray-500" data-td-toggle="datetimepicker" data-td-target="#FechaInicio2Seguimiento" value="@(DateTime.Now.ToString("dd/MM/yyyy"))" />
                        </div>

                    </div>

                    <!-- ===== Fila 2: Subtipo + Cobrador + Comentarios ===== -->
                    <div class="row g-3 mt-3">

                        <div class="col-12 col-md-3">
                            <label>Subtipo</label>
                            <select id="subtipo" name="subtipo" class="form-select" data-dropdown-parent="#CrearTefModal" data-control="select2" data-placeholder="Filtrar por un subtipo">
                                <option></option>
                                <option selected value="00">Todos</option>
                                @if (ViewBag.ListaSubtiposTODOS != null)
                                {
                                    foreach (var item in ViewBag.ListaSubtiposTODOS)
                                    {
                                        if (item.SUBTIPO.ToString() == "0" && item.DESCRIPCION == "Depósito")
                                        {
                                            <option value="@item.SUBTIPO">@item.SUBTIPO || @item.DESCRIPCION</option>
                                        }
                                    }
                                }
                            </select>
                        </div>

                        <div class="col-12 col-md-4">
                            <label>Cobrador del cliente</label>
                            <input type="text" class="form-control" id="cobrador" readonly />
                        </div>

                        <div class="col-12 col-md-5">
                            <label>Comentarios del cobrador</label>
                            <textarea name="Description" id="comentarioscob" rows="2" class="form-control" maxlength="250" placeholder="Ingrese un comentario"></textarea>
                        </div>

                    </div>

                    <!-- ===== Fila 3: Concepto ===== -->
                    <div class="row g-3 mt-3">
                        <div class="col-12">
                            <label>Concepto</label>
                            <input class="form-control" disabled id="concepto" value="00100001010000005178 | 00500001010000002979" />
                        </div>
                    </div>

                    <!-- ===== Fila 4: Facturas (opcional) ===== -->
                    <div class="row mt-4" id="facturas">
                        <!-- Contenido dinámico -->
                    </div>

                </div>
            </div>

            <!-- ===== Footer ===== -->
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary font-weight-bold" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" onclick="guardarcambios();" class="btn btn-success font-weight-bold">Guardar</button>
            </div>

        </div>
    </div>
</div>
@*</div>*@


<div class="modal fade" tabindex="-1" id="agregarRef">
    <div class="modal-dialog modal-dialog-centered ">
        <div class="modal-content">
            <div class="modal-header">
                <h3 class="modal-title">Seleccionar Deposito de Efectivo</h3>

                <!--begin::Close-->
                <div class="btn btn-icon btn-sm btn-active-light-primary ms-2" data-bs-dismiss="modal" aria-label="Close">
                    <span class="svg-icon svg-icon-muted svg-icon-2x">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path opacity="0.3" d="M6 19.7C5.7 19.7 5.5 19.6 5.3 19.4C4.9 19 4.9 18.4 5.3 18L18 5.3C18.4 4.9 19 4.9 19.4 5.3C19.8 5.7 19.8 6.29999 19.4 6.69999L6.7 19.4C6.5 19.6 6.3 19.7 6 19.7Z" fill="currentColor" />
