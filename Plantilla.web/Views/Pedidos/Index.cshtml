<script>
    const URL_PEDIDO = '@Url.Content("~/Pedidos")'
    const purl = '@Url.Content("~/Lineas")'
    const turl = '@Url.Content("~/Tracking")'
    const URLRTA = '@Url.Content("~/EstadosCuenta")'
    const urltracking = "https://10.10.1.254/Tracking/Tracking";
    const USUARIO_PER = '@Session["USUARIO_PER"]' == 1
    const permiso = '1'
    const MODULO_GESTION_PEDIDOS = '@Session["MOD_GESTION_DE_PEDIDOS"]'
    const PERMISOS_GESTION_PEDIDOS = '@Session["PERMISOS_GESTION_DE_PEDIDOS"]'



    function abrirModalPDF(DOCUMENTO) {
        $('#pdf_preview').empty();
        Dajax(`${URL_PEDIDO}/ObtenerPDF`,
            "POST", { factura: DOCUMENTO }, function (response) {
                if (response.responseText != "") {
                    $('#pdf_preview').removeClass('d-none');
                    var cuerpo = '<embed type="application/pdf" id="pdf" src="" style="width:100%; height:900px" />';
                    $("#pdf_preview").append(cuerpo);
                    $("#pdf").attr("src", response.responseJSON.FACTURA);
                    $("#Modal_PDF").modal("show");
                } else {
                    toastr.warning("No se encontró el PDF de esta factura");
                }
            });
    }

</script>
