
@{
    ViewBag.Title = "Pedidos";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<!--begin::Content wrapper-->
<div class="d-flex flex-column flex-column-fluid">

    <!--begin::Content-->
    <div id="kt_app_content" class="app-content flex-column-fluid">
        <!--begin::Content container-->
        <div id="kt_app_content_container" class="app-container container-xxl" style="max-width:100% !important">
            <!--begin::Toolbar-->
            <div id="kt_app_toolbar" class="app-toolbar py-3 py-lg-6">
                <!--begin::Page title-->
                <div class="page-title d-flex flex-column justify-content-center flex-wrap me-3">
                    <!--begin::Title-->
                    <h1 class="page-heading d-flex text-dark fw-bold fs-3 flex-column justify-content-center my-0">@ViewBag.Title</h1>
                    <!--end::Title-->
                </div>
                <!--end::Page title-->
            </div>
            <!--end::Toolbar-->
            <!--begin::Card-->
            <div class="card mb-6">
                <!--begin::Card body-->
                <div class="card-body pt-0">
                    <div class="row align-items-center mt-7">
                        <div class="form-group col-md-3 mt-3">
                            <label>Fecha de pedido</label>
                            <input class="form-control filtro" placeholder="Pick date rage" id="FechaInicio" value="@(
                             (Request["fecha_visita"] == null || Request["fecha_visita"] == "null") ? new DateTime(DateTime.Now.Year, DateTime.Now.Month, 1).ToString("dd/MM/yyyy")+ " - " +DateTime.Now.ToString("dd/MM/yyyy"): Request["fecha_visita"] + " - " + Request["fecha_visita"])" />

                        </div>

                        <div class="form-group col-md-3 mt-3 ">
                            <label>Pedido</label>
                            <select id="pedido" name="pedido" class="form-select filtro">
                                <option></option>
                                <option selected value="0">Todos</option>

                            </select>
                        </div>

                        <div class="form-group col-md-2 mt-3">
                            <label>Estado PED</label>
                            <select id="estado" name="estado" class="form-select filtro" data-control="select2" data-placeholder="Filtrar por un estado">
                                <option></option>
                                <option selected value="0">Todas</option>
                                @{
                                    if (ViewBag.EstadoPedido != null)
                                    {
                                        foreach (var item in ViewBag.EstadoPedido)
                                        {
                                            <option value="@item.ESTADO_PEDIDO">@item.DESCRIPCION</option>
                                        }
                                    }
                                }

                            </select>
                        </div>
                        <div class="form-group col-md-2 mt-3">
                            <label>Seguir FAC</label>
                            <select id="factura" name="factura" class="form-select filtro" data-control="select2" data-placeholder="Filtrar por seguir fact">
                                <option></option>
                                <option selected value="0">Todos</option>
                                @{
                                    if (ViewBag.EstadoFactura != null)
                                    {
                                        foreach (var item in ViewBag.EstadoFactura)
                                        {
                                            <option value="@item.ESTADO_FACTURA_SEGUIMIENTO">@item.DESCRIPCION</option>
                                        }
                                    }
                                }

                            </select>
                        </div>
                        <div class="col-md-2 mt-8">
                            <div class="input-icon">
                                <input type="text" class="form-control" placeholder="Buscar..." id="kt_datatable_search_query" data-kt-docs-table-filter="search" autocomplete="off" />
                                <span>
                                    <i class="flaticon2-search-1 text-muted"></i>
                                </span>
                            </div>
                        </div>

                    </div>
                </div>
                <!--end::Card body-->
            </div>
            <!--end::Card-->
            <!--begin::Card-->
            <div class="card">
                <!--begin::Card body-->
                <div class="card-body pt-0">

                    <!--begin::Table-->
                    <table class="table align-middle table-row-dashed fs-6 gy-4" id="miTabla">
                        <!--begin::Table head-->
                        <thead>
                            <!--begin::Table row-->
                            <tr class="text-start text-gray-600 fw-bold fs-7 text-uppercase gs-0">

                                <th class="min-w-10px pe-2">
                                    <div class="form-check form-check-sm form-check-custom form-check-solid me-3">
                                        <input class="form-check-input" id="checkAll" type="checkbox" data-kt-check="true" data-kt-check-target="#miTabla .form-check-input" />
                                    </div>
                                </th>
                                <th class="text-left min-w-10px verSubtabla"></th>
                                <th class="text-left min-w-100px">Pedido</th>
                                <th class="text-left min-w-80px ">Estado PED</th>
                                <th class="text-left min-w-100px ">Autorización</th>
                                <th class="text-left min-w-80px">Fecha Ped</th>
                                <th class="text-left min-w-80px">Factura</th>
                                <th class="text-left min-w-200px">Cliente</th>
                                <th class="text-left min-w-80px ">Seguir FAC</th>
                                <th class="text-left min-w-50px">Días</th>
                                <th class="min-w-80px" style="text-align:right">Subtotal</th>
                                <th class="min-w-80px" style="text-align:right">Total</th>
                                <th class="text-left min-w-150px">Acciones</th>
                                @*<th class="text-end"></th>*@
                            </tr>
                            <!--end::Table row-->
                        </thead>
                        <!--end::Table head-->
                        <!--begin::Table body-->
                        <tbody class="fw-bold text-gray-600">
                        </tbody>
                        <!--end::Table body-->
                    </table>
                    <!--end::Table-->
                </div>
                <!--end::Card body-->
            </div>
            <!--end::Card-->
        </div>
        <!--end::Content container-->
    </div>
    <!--end::Content-->
</div>
<!--end::Content wrapper-->


<div class="modal fade" tabindex="-1" id="modalvisita">
    <div class="modal-dialog modal-dialog-centered ">
        <div class="modal-content">
            <div class="modal-header">
                <h3 class="modal-title" id="labelvisita">Agregar nueva visita</h3>

                <!--begin::Close-->
                <div class="btn btn-icon btn-sm btn-active-light-primary ms-2" data-bs-dismiss="modal" aria-label="Close">
                    <span class="svg-icon svg-icon-muted svg-icon-2x">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path opacity="0.3" d="M6 19.7C5.7 19.7 5.5 19.6 5.3 19.4C4.9 19 4.9 18.4 5.3 18L18 5.3C18.4 4.9 19 4.9 19.4 5.3C19.8 5.7 19.8 6.29999 19.4 6.69999L6.7 19.4C6.5 19.6 6.3 19.7 6 19.7Z" fill="currentColor" />
                            <path d="M18.8 19.7C18.5 19.7 18.3 19.6 18.1 19.4L5.40001 6.69999C5.00001 6.29999 5.00001 5.7 5.40001 5.3C5.80001 4.9 6.40001 4.9 6.80001 5.3L19.5 18C19.9 18.4 19.9 19 19.5 19.4C19.3 19.6 19 19.7 18.8 19.7Z" fill="currentColor" />
                        </svg>
                    </span>
                </div>
                <!--end::Close-->
            </div>

            <div class="modal-body">
                <div class="row">

                    <div class="form-group mb-6">
                        <label>Cliente</label>
                        <input id="clientevisita" type="text" class="form-control text-gray-500" style="font-size:0.90rem;" value="" />
                    </div>
                    <div class="form-group mb-6">
                        <label>Tipo de visita</label>
                        <select id="tipovisita" name="tipovisita" class="form-select" data-control="select2" data-placeholder="Seleccione un tipo">
                            <option></option>
                            @{
                                if (ViewBag.TipoVisita != null)
                                {
                                    foreach (var item in ViewBag.TipoVisita)
                                    {
                                        <option value="@item.U_CODIGO">@item.U_DESCRIP</option>
                                    }
                                }
                            }
                        </select>
                    </div>
                    <div class="form-group mb-6">
                        <label>Fecha visita</label>
                        <input id="fechavisita" disabled type="text" class="form-control text-gray-500" style="font-size:0.90rem;" value="@(DateTime.Now.ToString("dd/MM/yyyy hh:mm:ss tt"))" />
                    </div>
                    <div class="form-group mb-6">
                        <label>Latitud</label>
                        <input id="latitudvisita" disabled type="text" class="form-control text-gray-500" style="font-size:0.90rem;" value="" />
                    </div>
                    <div class="form-group mb-6">
                        <label>Longitud</label>
                        <input id="longitudvisita" disabled type="text" class="form-control text-gray-500" style="font-size:0.90rem;" value="" />
                    </div>
                    <div class="form-group mb-6">
                        <label>Comentarios</label>
                        <textarea class="form-control text-gray-500" rows="2" placeholder="Ingrese un comentario" id="comentariovisita"></textarea>
                    </div>
                    <div class="form-group mb-6">
                        <label>Usuario</label>
                        <input id="usuariovisita" disabled type="text" class="form-control text-gray-500" style="font-size:0.90rem;" value="@Session["Usuario"].ToString()" />
                    </div>
                    <div class="form-group mb-6">
                        <label>Fecha creación</label>
                        <input id="fechacreacion" disabled type="text" class="form-control text-gray-500" style="font-size:0.90rem;" value="@(DateTime.Now.ToString("dd/MM/yyyy"))" />
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" id="deleteButton" onclick="guardarVisita();" class="btn btn-success">Guardar</button>
            </div>
        </div>
    </div>
</div>




@*++++++++++++++++++++++++++++++++++++++++++++++++MODAL Ver PDF ++++++++++++++++++++++++++++++++++++++++++++++++++++++*@

<!-- Modal -->
<div class="modal fade" tabindex="-1" id="Modal_PDF">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h3 class="modal-title">Ver PDF</h3>
                <div class="btn btn-icon btn-sm btn-active-light-primary ms-2" data-bs-dismiss="modal" aria-label="Close">
                    <span class="svg-icon svg-icon-muted svg-icon-2x">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path opacity="0.3" d="M6 19.7C5.7 19.7 5.5 19.6 5.3 19.4C4.9 19 4.9 18.4 5.3 18L18 5.3C18.4 4.9 19 4.9 19.4 5.3C19.8 5.7 19.8 6.29999 19.4 6.69999L6.7 19.4C6.5 19.6 6.3 19.7 6 19.7Z" fill="currentColor" />
                            <path d="M18.8 19.7C18.5 19.7 18.3 19.6 18.1 19.4L5.40001 6.69999C5.00001 6.29999 5.00001 5.7 5.40001 5.3C5.80001 4.9 6.40001 4.9 6.80001 5.3L19.5 18C19.9 18.4 19.9 19 19.5 19.4C19.3 19.6 19 19.7 18.8 19.7Z" fill="currentColor" />
                        </svg>
                    </span>
                </div>
            </div>

            <div class="modal-body">
                <div id="pdf_preview" class="d-none" style="pointer-events:auto;">
                    <!-- Embed PDF -->
                    <embed type="application/pdf" id="pdf" src="" style="width:100%; height:800px" />
                </div>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-light-primary" data-bs-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>



