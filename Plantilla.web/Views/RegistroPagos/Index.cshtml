    const MODULO_PORTAL_DE_CLIENTES = '@Session["MOD_PORTAL_DE_CLIENTES"]'
    const PERMISOS_PORTAL_DE_CLIENTES = '@Session["PERMISOS_PORTAL_DE_CLIENTES"]'

