                } else if (exception === 'parsererror') {
                    error = 'Fallo la conversión a JSON.';
                } else if (exception === 'timeout') {
                    error = 'Error de tiempo de espera.';
                } else if (exception === 'abort') {
                    error = 'Solicitud Ajax abortada.';
                } else {
