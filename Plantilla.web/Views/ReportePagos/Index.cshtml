                        <select class="form-select" id="bancomodal" style="width:100%" data-control="select2" data-placeholder="Selecione una opción">
                            <option value="BAC">BAC</option>
                            <option value="BCR">BCR</option>
                            <option value="BNCR">BNCR</option>
                        </select>
                    </div>
                    <div class="col-md-3 mt-5 fmp" id="numtefr">
                        <label id="labelfmp2"># Referencia Transferencia</label>
                        <input type="text" class="form-control filtro" name="start" autocomplete="off" value="5178" />
                    </div>


                    <div class="col-md-3 mt-5 fmp" id="fechaposr">
                        <label id="labelfmp">Fecha Transferencia</label>
                        <input id="FechaInicio2Seguimiento" type="text" class="form-control fecha text-gray-500" data-td-toggle="datetimepicker" style="font-size:0.90rem;" data-td-target="#FechaInicio2Seguimiento" value="@(DateTime.Now.ToString("dd/MM/yyyy"))" />

                    </div>
                    <div class="col-md-3 mt-5 fmp">
                        <label id="labelfmp">Subtipo</label>
                        <select class="form-control form-control-solid" style="width:100%" id="subtipom">
                            <option selected value="Depósito">Depósito</option>
                            <option value="Depósito sin identificar">Depósito sin identificar</option>
                        </select>
