            <div class="modal-body row">
                <div class="col-12 d-flex row mt-4">

                    <div class="col-md-2 mt-5">
                        <label># Número de recibo</label>
                        <input type="text" class="form-control form-control-solid filtro" disabled id="numrecibo" name="start" autocomplete="off" value="C02300000001" />
                    </div>
                    <div class="col-md-2 mt-5">
                        <label>Fecha de recibo</label>
                        <input type="text" class="form-control form-control-solid fechas" readonly placeholder="Seleccionar fecha" id="fechapago" value="@(DateTime.Now.ToString("dd/MM/yyyy"))" disabled />
                    </div>
                    <div class="col-md-1 mt-5">
                        <label>Moneda</label>
                        <input disabled type="text" class="form-control" id="moneda" placeholder="Ingrese el monto del documento" value="CRC" />
                    </div>
                    <div class="col-md-2 mt-5">
                        <label>Monto seleccionado</label>
                        <input type="text" class="form-control filtro" id="total" name="start" autocomplete="off" value="₡50,000.00" />
                    </div>
                    <div class="col-md-2 mt-5">
                        <label>Saldo a favor </label>
                        <input type="text" class="form-control filtro" id="saldofavor" name="start" autocomplete="off" value="₡0" disabled />
                    </div>
                    <div class="col-md-3 mt-5">
                        <label>Forma de pago</label>
                        <select class="form-control " style="width:100%" id="formpago">

                            <option SELECTED value="Depósito">Depósito</option>
                            <option value="Transferencia">Transferencia</option>
                        </select>
                    </div>


                    <div class="col-md-3 mt-5 fmp" id="bancor">
