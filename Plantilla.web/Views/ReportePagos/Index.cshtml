
@{
    ViewBag.Title = "Reporte de Pagos";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .custom-column {
        width: 20%; /* 100% dividido por 5 */
        float: left;
        box-sizing: border-box;
        padding-left: 10px;
        padding-right: 10px;
        padding-top: 4px;
        padding-bottom: 4px;
    }

    .clearfix::after {
        content: "";
        display: table;
        clear: both;
    }
</style>
<!--begin::Content wrapper-->
<div class="d-flex flex-column flex-column-fluid">

    <!--begin::Content-->
    <div id="kt_app_content" class="app-content flex-column-fluid">
        <!--begin::Content container-->
        <div id="kt_app_content_container" class="app-container container-xxl" style="max-width:100% !important">
            <!--begin::Toolbar-->
            <div id="kt_app_toolbar" class="app-toolbar py-3 py-lg-6">
                <!--begin::Page title-->
                <div class="page-title d-flex flex-column justify-content-center flex-wrap me-3">
                    <!--begin::Title-->
                    <h1 class="page-heading d-flex text-dark fw-bold fs-3 flex-column justify-content-center my-0">@ViewBag.Title</h1>
                    <!--end::Title-->
                </div>
                <!--end::Page title-->
            </div>
            <!--end::Toolbar-->
            <!--begin::Card-->
            <div class="card mb-6">
                <!--begin::Card body-->
                <div class="card-body pt-0">
                    <div class="row align-items-center mt-7">

                        <div class="form-group col-md-4 mb-4">
                            <label>Rango de fechas</label>
                            <input class="form-control filtro" placeholder="Pick date rage" id="FechaInicioV" value="@((new DateTime(DateTime.Now.Year, DateTime.Now.Month, 1).ToString("dd/MM/yyyy"))+ " - " + DateTime.Now.ToString("dd/MM/yyyy"))" />
                        </div>
                        <div class="col-md-2 mb-4">
                            <label>Cliente</label>
                            <select id="cliente" class="form-select" data-control="select2" data-placeholder="Filtrar" style="width:100%">
                                <option></option>
                                <option selected value="0">Todos los clientes</option>
                                <option value="Farmacia El Parque">3101090101 - Farmacia El Parque</option>
                                <option value="Macrobiotica Gotitas Salud">801190243 - Macrobiotica Gotitas Salud</option>
                            </select>
                        </div>
                        <div class="col-md-2 mb-4">
                            <label>Cobrador</label>
                            <select id="cobrador" class="form-select" data-control="select2" data-placeholder="Filtrar" style="width:100%">
                                <option></option>
                                <option selected value="0">Todas</option>
                                <option value="7008">7008 - HELLEN ALFARO</option>
                                <option value="7009">7009 - GRACE QUESADA</option>
                                <option value="7012">7012 - MARINA VILLALOBOS</option>
                            </select>
                        </div>
                        <div class="col-md-2 mb-4">
                            <label>Banco</label>
                            <select id="banco" class="form-select" data-control="select2" data-placeholder="Filtrar" style="width:100%">
                                <option></option>
                                <option selected value="0">Todos</option>
                                <option value="BAC">BAC</option>
                            </select>
                        </div>
                        <div class="col-md-2 mb-4">
                            <label>Tipo</label>
                            <select id="tipo" class="form-select" data-control="select2" data-placeholder="Filtrar" style="width:100%">
                                <option></option>
                                <option selected value="0">Todos</option>
                                <option value="REC">REC</option>
                            </select>
                        </div>
                        <div class="col-md-4 mb-4">
                            <label>Forma de pago</label>
                            <select id="formapgo" class="form-select" data-control="select2" data-placeholder="Filtrar" style="width:100%" multiple>
                                <option></option>
                                <option selected value="Efectivo">Efectivo</option>
                                <option value="Sinpe móvil">Sinpe móvil</option>
                                <option selected value="Cheque">Cheque</option>
                                <option value="Cheque postfechado">Cheque postfechado</option>
                                <option value="Transferencia">Transferencia</option>
                            </select>
                        </div>
                        <div class="col-md-2 mb-4">
                            <label>Estado</label>
                            <select id="estado" class="form-select" data-control="select2" data-placeholder="Filtrar" style="width:100%">
                                <option></option>
                                <option selected value="0">Todos</option>
                                <option value="Sin aprobar">Sin aprobar</option>
                                <option value="Aprobado">Aprobado</option>
                                <option value="Rechazado">Rechazado</option>
                                <option value="No depositado">No depositado</option>
                            </select>
                        </div>


                        <div class="col-md-2 mt-3">
                            <div class="input-icon">
                                <input type="text" class="form-control" placeholder="Buscar..." id="kt_datatable_search_query" data-kt-docs-table-filter="search" autocomplete="off" />
                                <span>
                                    <i class="flaticon2-search-1 text-muted"></i>
                                </span>
                            </div>
                        </div>

                    </div>
                </div>
                <!--end::Card body-->
            </div>
            <!--end::Card-->
