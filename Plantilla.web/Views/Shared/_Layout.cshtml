    @functions {
        public static bool TienePermiso(string[] requeridos, HttpSessionStateBase session)
        {
            var permisos = session["PERMISOS_MENU"]?.ToString().Split(',') ?? new string[0];
            return requeridos.Any(p => permisos.Contains(p));


        }

    }
    @{
        var forceMobileByQuery = string.Equals(Context.Request["mobile"], "1", StringComparison.OrdinalIgnoreCase);
        var userAgent = (Context.Request.Headers["User-Agent"] ?? string.Empty).ToLowerInvariant();
        var browserIsMobile = Context.Request.Browser != null && Context.Request.Browser.IsMobileDevice;
        var isMobile = forceMobileByQuery
            || browserIsMobile
            || userAgent.Contains("mobi")
            || userAgent.Contains("android")
            || userAgent.Contains("iphone")
            || userAgent.Contains("ipad")
            || userAgent.Contains("ipod")
            || userAgent.Contains("tablet")
            || userAgent.Contains("lenovo")
            || userAgent.Contains("silk")
            || userAgent.Contains("kindle");
    }
    <script>
        const isMobileFromServer = @isMobile.ToString().ToLower();
        (function () {
            const params = typeof URLSearchParams === 'function' ? new URLSearchParams(window.location.search) : null;
            const forceMobileByQuery = params ? params.get('mobile') === '1' : /[?&]mobile=1(?:&|$)/.test(window.location.search);
            let forceMobileByStorage = false;
            try {
                forceMobileByStorage = localStorage.getItem('force_mobile') === '1';
            } catch (e) {
                forceMobileByStorage = false;
            }

            const ua = (navigator.userAgent || '').toLowerCase();
            const hasTouch = ('ontouchstart' in window) || ((navigator.maxTouchPoints || 0) > 0);
            const looksLikeAndroidTablet = /android|silk|kindle|lenovo|tablet|tab/.test(ua);
            const smallOrTabletScreen = Math.min(window.screen.width || 0, window.screen.height || 0) <= 1024;

            window.isMobile = forceMobileByQuery
                || forceMobileByStorage
                || isMobileFromServer
                || (hasTouch && (looksLikeAndroidTablet || smallOrTabletScreen));

            window.setForceMobile = function (enabled) {
                try {
                    localStorage.setItem('force_mobile', enabled ? '1' : '0');
                } catch (e) { }
            };
        })();

        const isMobile = window.isMobile;
    </script>
    <script>
        let arraycliente = [];
        let cambiarVendedor = true;
        let cambiarCobrador = true;

        let arraycobrador = [];

        // Obtener el título de la vista desde ViewBag y asignarlo a una variable JavaScript
        let currentTitle = '@ViewBag.Title';
        $(document).ready(function () {
            $.when(CargarComboVendedor(), CargarComboCobrador()).done(function(){
                cargaClienteVendedorCobrador();
            });
        });

        function CargarComboCobrador() {
            return $.ajax({
                url: `${HOME_URL}/MostrarCobrador`,
                type: "POST",
                success: function (data) {
                    const opciones = data.map(opcion => `
                        <option value="${opcion.COBRADOR}" ${opcion.COBRADOR === '@Session["Cod_Cobrador"]' ? "selected" : ""}>
                            ${opcion.COBRADOR} - ${opcion.NOMBRE}
                        </option>
                    `).join('');
                    $("#cobradorFiltro").html(`<option value='0'>Todos</option>${opciones}`);
                },
                error: function (data) {
                    console.error(`${arguments.callee.name} error:`, data);
                    toastr.error(data.der);
                }
            });
        }

        function CargarComboVendedor() {
            return $.ajax({
                url: `${HOME_URL}/MostrarVendedor`,
                type: "POST",
                success: function (data) {
                    const opciones = data.map(opcion => `
                        <option value="${opcion.COD_VENDEDOR}" ${opcion.COD_VENDEDOR === '@Session["Vendedor"]' ? "selected" : ""}>
                            ${opcion.COD_VENDEDOR} - ${opcion.NOM_VENDEDOR}
                        </option>
                    `).join('');
                    $("#vendedorFiltro").html(`<option value='0'>Todos</option>${opciones}`);
                },
                error: function (data) {
                    console.error("error: ", data);
                    toastr.error(data.der);
                }
            });
        }

        function cargaClienteVendedorCobrador() {
            let cobrador = '0';
            let vendedor = '0';
            let cliente = '@Session["cliente"]';
    
            $.ajax({
                url: `${HOME_URL}/MostrarClienteCobrador_Vendedor`,
                data: { cobrador, vendedor },
                type: "POST",
                success: function (data) {
                    const opcionesCliente = data.map(opcion =>
                        `<option value="${opcion.CLIENTE}" ${opcion.CLIENTE === cliente ? "selected" : ""}>
                            ${opcion.CLIENTE} - ${opcion.ALIAS}
                        </option>`
                    ).join("");

                    $("#clientesFiltro").html(`<option selected value='0'>Todos</option>${opcionesCliente}`);
                    $(document).trigger('clientes-cargados-layout');
                },
                error: function (data) {
                    console.error(`${arguments.callee.name} error:`, data);
                    toastr.error(data.der);
                }
            });
        }


        function cargaClienteComprador() {
            let cobrador = $("#cobradorFiltro").val() //'@Session["Cod_Cobrador"]';
            let clienteSesion = '@Session["cliente"]';

            if (!cobrador) {
                return toastr.warning("Debe seleccionar un vendedor.");
            }

            $.ajax({
                url: `${HOME_URL}/MostrarCliente_Cobrador`,
                data: { cobrador },
                type: "POST",
                success: function (data) {
                    const opcionesClientes = data.map(opcion =>
                        `<option value='${opcion.CLIENTE}' ${opcion.CLIENTE === clienteSesion ? "selected" : ""}>
                            ${opcion.CLIENTE} - ${opcion.ALIAS}
                        </option>`
                    ).join('');

                    $("#clientesFiltro").html(`<option selected value='0'>Todos</option>${opcionesClientes}`);
                    $(document).trigger('clientes-cargados-layout');

                    //const clienteInfo = data.find(cliente => cliente.CLIENTE === clienteSesion) || {
                    //    CLIENTE: "Todos",
                    //    ALIAS: "",
                    //    LIMITE_CREDITO: 0,
                    //    SALDO: 0,
                    //    DISPONIBLE: 0,
                    //    DOC_VENC: 0
                    //};

                    //$("#spancliente").text(`${clienteInfo.CLIENTE} - ${clienteInfo.ALIAS}`);
                    //$("#clienteInfoFiltro").text(`${clienteInfo.CLIENTE} - ${clienteInfo.ALIAS}`);
                    //$("#limiteCredito").html(clienteInfo.LIMITE_CREDITO.toLocaleString());
                    //$("#saldoInfoFiltro").html(clienteInfo.SALDO.toLocaleString());
                    //$("#disponibleInfoFiltro").html(clienteInfo.DISPONIBLE.toLocaleString());
                    //$("#docVenInfoFiltro").html(clienteInfo.DOC_VENC);
                },
                error: function (data) {
                    console.error(`${arguments.callee.name} error:`, data);
                    toastr.error(data.der);
                }
            });
        }


        function CambiarCliente() {
            var setCli = $("#clientesFiltro").val()
            
            if (setCli != "" && setCli != null) {
                $.ajax({
                    url: `${HOME_URL}/CambiarCliente`,
                    data: { clienteinfo: setCli },
                    async: true,
                    type: "POST",
                    success: function (data) {
                        console.log(data)
                        if (data.status === '1') {
                            if (data.vendedor !== "0" && $("#vendedorFiltro").val() !== data.vendedor) {
                                //cambiarVendedor = false;
                                $("#vendedorFiltro").val(data.vendedor).trigger("change.select2");
                            }

                            if (data.cobrador !== "0" && $("#cobradorFiltro").val() !== data.cobrador) {
                                //cambiarVendedor = false;
                                $("#cobradorFiltro").val(data.cobrador).trigger("change.select2");
                            }

                            //cargaClienteVendedorCobrador(setCli);
                            //window.location.reload();

                            // Se mantiene la lista global de clientes sin filtrarla por vendedor/cobrador.
                            // Aquí solo sincronizamos vendedor y cobrador según el cliente seleccionado.
                            $(document).trigger('filtros-actualizados', {
                                vendedor: $("#vendedorFiltro").val(),
                                cobrador: $("#cobradorFiltro").val(),
                                cliente: $("#clientesFiltro").val()
                            });
                        }
                    },
                    error: function (data) {
                        console.error(`${arguments.callee.name} error:`, data);
                        toastr.error(data.der);
                    }
                });
            } else {
                toastr.warning("Debe seleccionar un vendedor.");
            }
        }



    </script>

