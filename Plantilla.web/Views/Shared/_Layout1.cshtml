    <script>
    var arraycliente = [];
    // Determinar la URL de acuerdo a la vista actual
    //const URLLayout = getURLLayout();
    //console.log(URLLayout);

    $(document).ready(function () {
        $.ajax({
            url: `${HOME_URL}/MostrarVendedor`,
            data: {},
            async: true,
            type: "POST",
            success: function (data) {
                var vendedor = ""; // Agregar la opción 'Todos' <option value='0'>Todos</option>

                for (var i in data) {
                    var opcion = data[i];
                    vendedor += "<option value='" + opcion.COD_VENDEDOR + "' " + (opcion.COD_VENDEDOR === '@Session["Vendedor"]' ? "selected" : "") + ">" + opcion.COD_VENDEDOR + ' - ' + opcion.NOM_VENDEDOR + "</option>";
                }
                $("#vendedorFiltro").html(vendedor);
                //$("#vendedorFiltro").change();
                cargaClienteVendedor();
            },
            error: function (data) {
                toastr.error(data.der);
            }
        });

        });


    function cargaClienteVendedor() {
        let _vendedor = '@Session["Vendedor"]';
        let _cliente = '@Session["cliente"]';
        if (_vendedor != "" && _vendedor != null) {
            $.ajax({
                url: `${HOME_URL}/MostrarClienteVendedor`,
                data: { vendedor: _vendedor },
                async: true,
                type: "POST",
                success: function (data) {
                    var cliente = "<option selected value='0'>Todos</option>"; // Agregar la opción 'Todos'
                    for (var i in data) {
                    var opcion = data[i];

                        //if (_cliente != null) {
                        //    cliente += "<option value='" + opcion.CLIENTE + "' " + (opcion.CLIENTE === _cliente ? "selected" : "") + ">" + opcion.CLIENTE + ' - ' + opcion.ALIAS + "</option>";
                        //    arraycliente.push(opcion);
                        //}
                        //else {
                            cliente += "<option value='" + opcion.CLIENTE + "' " + (opcion.CLIENTE === '@Session["cliente"]' ? "selected" : "") + ">" + opcion.CLIENTE + ' - ' + opcion.ALIAS + "</option>";
                            arraycliente.push(opcion);
                        /*}*/
                    }
                    $("#clientesFiltro").html(cliente);
                    // Actualizar el campo clienteInfoFiltro con el cliente en la sesión iniciada
                    let clienteSesion = arraycliente.find(function (cliente) {
                        return cliente.CLIENTE === '@Session["cliente"]';
                    });

                    @*let clienteSesion = _cliente !== ""? arraycliente.find(function (cliente) {
                        return cliente.CLIENTE === _cliente;
                      }): arraycliente.find(function (cliente) {
                        return cliente.CLIENTE === '@Session["ClienteInfo"]';
                      });*@

                    if (clienteSesion) {
                        //let clienteInfo = clienteSesion.CLIENTE + ' - ' + clienteSesion.ALIAS;
                        $("#spancliente").text(clienteSesion.CLIENTE + " - " + clienteSesion.ALIAS);
                        $("#clienteInfoFiltro").text(clienteSesion.CLIENTE + ' - ' + clienteSesion.ALIAS);
                        $("#limiteCredito").html(clienteSesion.LIMITE_CREDITO.toLocaleString());
                        $("#saldoInfoFiltro").html(clienteSesion.SALDO.toLocaleString());
                        $("#disponibleInfoFiltro").html(clienteSesion.DISPONIBLE.toLocaleString());
                        $("#docVenInfoFiltro").html(clienteSesion.DOC_VENC);

                    } else {
                        $("#spancliente").text("Todos");
                        $("#clienteInfoFiltro").text("Todos");
                        $("#limiteCredito").html("0");
                        $("#saldoInfoFiltro").html("0");
                        $("#disponibleInfoFiltro").html("0");
                        $("#docVenInfoFiltro").html("0");
                    }
                },
                error: function (data) {
                    toastr.error(data.der);
                }
            });
        } else {
            toastr.warning("Debe seleccionar un vendedor.");
        }
    }

    function CambiarCliente() {
        var setCli = $("#clientesFiltro").val()
        console.log(setCli);
        if (setCli != "" && setCli != null) {
            $.ajax({
                url: `${HOME_URL}/CambiarCliente`,
                data: { clienteinfo: setCli },
                async: true,
                type: "POST",
                success: function (data) {
                    console.log(data)
                },
                error: function (data) {
                    toastr.error(data.der);
                }
            });
        } else {
            toastr.warning("Debe seleccionar un vendedor.");
        }
    }







