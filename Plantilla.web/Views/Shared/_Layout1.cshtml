                                <span id="rolText">@((ViewBag.Title == "Registro de pagos") ? "Cobrador" : "Vendedor"): </span>
                                <span id="spanvendedor">@Session["Vendedor"] - @Session["NomVendedor"]</span>
                            </span>*@
