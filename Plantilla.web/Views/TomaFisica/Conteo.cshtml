
@{
    ViewBag.Title = "Conteo";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<script type='text/javascript' src='http://paperjs.org/assets/js/paper.js'></script>
<!--begin::Content wrapper-->
<div class="d-flex flex-column flex-column-fluid">

    <!--begin::Content-->
    <div id="kt_app_content" class="app-content flex-column-fluid">
        <!--begin::Content container-->
        <div id="kt_app_content_container" class="app-container container-xxl" style="max-width:100% !important">
            <!--begin::Toolbar-->
            <div id="kt_app_toolbar" class="app-toolbar py-3 py-lg-6">
                <!--begin::Page title-->
                <div class="page-title d-flex flex-column justify-content-center flex-wrap me-3">
                    <!--begin::Title-->
                    <h1 class="page-heading d-flex text-dark fw-bold fs-3 flex-column justify-content-center my-0">@ViewBag.Title</h1>
                    <!--end::Title-->
                </div>
                <!--end::Page title-->
            </div>
            <!--end::Toolbar-->
            <!--begin::Card-->
            <div class="card mb-6">
                <!--begin::Card body-->
                <div class="card-body pt-0">

                    <div class="row align-items-center mt-7">
                        <div class="form-group col-md-3 mt-3 ">
                            <label>Responsable</label>
                            <select id="responsable" name="responsable" class="form-select" data-control="select2" data-placeholder="Filtrar por un responsable">
                                <option></option>
                                <option selected value="0">Todos</option>
                                <option value="CRC00130 - BENAVIDEZ COTO JULIO ALBERTO1">CRC00130 - BENAVIDEZ COTO JULIO ALBERTO1</option>
                                <option value="CRC00339 - ESQUIVEL SANCHEZ JEFFERSON GERARDO">CRC00339 - ESQUIVEL SANCHEZ JEFFERSON GERARDO</option>
                                <option value="CRC00235 - CASTRO ZUÑIGA LUIS FABIAN">CRC00235 - CASTRO ZUÑIGA LUIS FABIAN</option>
                                <option value="CRC00381 - GARCIA GARCIA ANTONIO">CRC00381 - GARCIA GARCIA ANTONIO</option>

                            </select>
                        </div>
                        <div class="col-md-3 mt-3">
                            <label>Lectura por RFID</label>
                            <div class="input-icon">
                                <input type="text" class="form-control" placeholder="Buscar..." id="RFID" autocomplete="off" />
                                <span>
                                    <i class="flaticon2-search-1 text-muted"></i>
                                </span>
                            </div>
                        </div>
                        <div class="col-md-3 mt-3">
                            <label>Lectura por código de barras</label>
                            <div class="input-icon">
                                <input type="text" class="form-control" placeholder="Buscar..." id="codbarras" autocomplete="off" />
                                <span>
                                    <i class="flaticon2-search-1 text-muted"></i>
                                </span>
                            </div>
                        </div>
                        <div class="col-md-3 mt-3">
                            <label>Lectura por código de activo</label>
                            <div class="input-icon">
                                <input type="text" class="form-control" placeholder="Buscar..." id="codactivo" autocomplete="off" />
                                <span>
                                    <i class="flaticon2-search-1 text-muted"></i>
                                </span>
                            </div>
                        </div>
                        <div class="col-md-3 mt-8">
                            <div class="input-icon">
                                <input type="text" class="form-control" placeholder="Buscar..." id="kt_datatable_search_query" data-kt-docs-table-filter="search" autocomplete="off" />
                                <span>
                                    <i class="flaticon2-search-1 text-muted"></i>
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
                <!--end::Card body-->
            </div>
            <!--end::Card-->
            <!--begin::Card-->
            <div class="card">
                <!--begin::Card body-->
                <div class="card-body pt-0">

                    <!--begin::Table-->
                    <table class="table align-middle table-row-dashed fs-6 gy-4" id="miTabla">
                        <!--begin::Table head-->
                        <thead>
                            <!--begin::Table row-->
                            <tr class="text-start text-gray-600 fw-bold fs-7 text-uppercase gs-0">
                                <th class="w-10px pe-2">
                                    <div class="form-check form-check-sm form-check-custom form-check-solid me-3">
                                        <input class="form-check-input" type="checkbox" data-kt-check="true" data-kt-check-target="#miTabla .form-check-input" value="1" />
                                    </div>
                                </th>
                                <th class="text-left min-w-125px">Activo</th>
                                <th class="text-left min-w-350px">Descripción</th>
                                <th class="text-left min-w-250px">Tipo</th>
                                <th class="text-left min-w-100px">Responsable</th>
                                <th class="text-left min-w-100px">Existencia</th>
                                <th class="text-left min-w-100px">Físico</th>
                                <th class="text-left min-w-100px">Ubicación</th>
                                <th class="text-left min-w-150px">Encontrado</th>
                                @*<th class="text-left min-w-350px">Acciones</th>*@
                                @*<th class="text-end"></th>*@
                            </tr>
                            <!--end::Table row-->
                        </thead>
                        <!--end::Table head-->
                        <!--begin::Table body-->
                        <tbody class="fw-bold text-gray-600">
                        </tbody>
                        <!--end::Table body-->
                    </table>
                    <!--end::Table-->
                </div>
                <!--end::Card body-->
            </div>
            <!--end::Card-->
        </div>
        <!--end::Content container-->
    </div>
    <!--end::Content-->
</div>
<!--end::Content wrapper-->


