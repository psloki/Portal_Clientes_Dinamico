
@{
    ViewBag.Title = "Tracking";
    Layout = "~/Views/Shared/_Layout.cshtml";
    
}
<!--begin::Content wrapper-->
<div class="d-flex flex-column flex-column-fluid">

    <!--begin::Content-->
    <div id="kt_app_content" class="app-content flex-column-fluid">
        <!--begin::Content container-->
        <div id="kt_app_content_container" class="app-container container-xxl" style="max-width:100% !important">
            <!--begin::Toolbar-->
            <div id="kt_app_toolbar" class="app-toolbar py-3 py-lg-6">
                <!--begin::Page title-->
                <div class="page-title d-flex flex-column justify-content-center flex-wrap me-3">
                    <!--begin::Title-->
                    <h1 class="page-heading d-flex text-dark fw-bold fs-3 flex-column justify-content-center my-0">@ViewBag.Title</h1>
                    <!--end::Title-->
                </div>
                <!--end::Page title-->
            </div>
            <!--end::Toolbar-->
            <!--begin::Card-->
            <div class="card mb-6">
                <!--begin::Card body-->
                <div class="card-body pt-0">
                    <div class="row align-items-center mt-7">
                        <div class="form-group col-md-4 mt-3">
                            <label>Fecha de pedido</label>
                            <input class="form-control " placeholder="Pick date rage" id="FechaInicioFin" value="@(DateTime.Now.ToString("01/MM/yyyy")) - @(DateTime.Now.ToString("dd/MM/yyyy"))" />
                        </div>

                        <div class="form-group col-md-4 mt-3 ">
                            <label>Fecha de Logística</label>
                            <div class="input-group" data-td-target-input="nearest" data-td-target-toggle="nearest">
                                <input class="form-check-input  me-2 my-auto" type="checkbox" value="" id="checkboxfecha" />
                                <input class="form-control " disabled placeholder="Pick date rage" id="FechaRuta" value="@(DateTime.Now.ToString("01/MM/yyyy")) - @(DateTime.Now.ToString("dd/MM/yyyy"))" />

                            </div>

                        </div>
                        <div class="form-group col-md-4 mt-3 ">
                            <label>Fecha CXC Recibe</label>
                            <div class="input-group" data-td-target-input="nearest" data-td-target-toggle="nearest">
                                <input class="form-check-input  me-2 my-auto" type="checkbox" value="" id="checkboxfechaCxcRecibe" />
                                <input class="form-control " disabled placeholder="Pick date rage" id="FechaCxcRecibe" value="@(DateTime.Now.ToString("01/MM/yyyy")) - @(DateTime.Now.ToString("dd/MM/yyyy"))" />

                            </div>


                        </div>
                        <div class="form-group col-md-2 mt-3 ">
                            <label>Pedido</label>
                            <select id="pedido" name="pedido" class="form-select">
                                <option></option>
                                <option selected value="0">Todos</option>

                            </select>
                        </div>
                        <div class="form-group col-md-2 mt-3">
                            <label>Factura</label>
                            <select id="factura" name="factura" class="form-select" data-placeholder="Filtrar por una factura">
                                <option></option>
                                <option selected value="99">Con facturas</option>
                                <option selected value="0">Todos</option>

                            </select>
                        </div>

                        <div class="form-group col-md-2 mt-3">
                            <label>Estado PED</label>
                            <select id="filtrestadopedido" name="filtrestadopedido" class="form-select" data-control="select2" data-placeholder="Filtrar por un estado">
                                <option></option>
                                <option selected value="0">Todas</option>
                                @{
                                    if (ViewBag.EstadoPedido != null)
                                    {
                                        foreach (var item in ViewBag.EstadoPedido)
                                        {
                                            <option value="@item.ESTADO_PEDIDO">@item.DESCRIPCION</option>
                                        }
                                    }
                                }

                            </select>
                        </div>
                        <div class="form-group col-md-2 mt-3">
                            <label>Seguir FAC</label>
                            <select id="estado" name="estado" class="form-select" data-control="select2" data-placeholder="Filtrar por rutas">
                                <option></option>
                                <option selected value="0">Todos</option>
                                @{
                                    if (ViewBag.EstadoFactura != null)
                                    {
                                        foreach (var item in ViewBag.EstadoFactura)
                                        {
                                            <option value="@item.ESTADO_FACTURA_SEGUIMIENTO">@item.DESCRIPCION</option>
                                        }
                                    }
                                }

                            </select>
                        </div>
                        <div class="form-group col-md-2 mt-3">
                            <label>TLA Estado</label>
                            <select id="tlaestado" name="tlaestado" class="form-select" multiple data-control="select2" data-placeholder="Filtrar por un cliente">
                                <option></option>
                                <option selected value="0">Todos</option>
                                @{
                                    if (ViewBag.TLA_Estado != null)
                                    {
                                        foreach (var item in ViewBag.TLA_Estado)
                                        {
                                            <option value="@item.TLA_ESTADO">@item.TLA_ESTADO</option>
                                        }
                                    }
                                }

                            </select>
                        </div>
                        <div class="form-group col-md-2 mt-3">
                            <label>Corte TLA</label>
                            <select id="horascorte" name="horascorte" class="form-select" data-control="select2" data-placeholder="Filtrar por un cliente">
                                <option></option>
                                <option selected value="0">Todos</option>
                                @{
                                    if (ViewBag.HoraCorte != null)
                                    {
                                        foreach (var item in ViewBag.HoraCorte)
                                        {
                                            <option value="@item.U_HORA_CORTE">@item.U_HORA_CORTE</option>
                                        }
                                    }
                                }

                            </select>
                        </div>
                        <div class="form-group col-md-2 mt-3">
                            <label>Agente</label>
                            <select id="vendedor" name="vendedor" class="form-select" data-control="select2" data-placeholder="Filtrar por un agente">
                                <option></option>
                                <option selected value="0">Todos</option>
                                @{
                                    if (ViewBag.Vendedor != null)
                                    {
                                        foreach (var item in ViewBag.Vendedor)
                                        {
                                            <option value="@item.VENDEDOR">@item.VENDEDOR | @item.NOMBRE</option>
                                        }
                                    }
                                }

                            </select>
                        </div>
                        <div class="form-group col-md-2 mt-3">
                            <label>Cobrador</label>
                            <select id="CobradorTracking" name="CobradorTracking" class="form-select" data-control="select2" data-placeholder="Filtrar por un cobrador">
                                <option></option>
                                <option selected value="0">Todos</option>
                                @{
                                    if (ViewBag.Cobrador != null)
                                    {
                                        foreach (var item in ViewBag.Cobrador)
                                        {
                                            <option value="@item.COBRADOR">@item.COBRADOR - @item.NOMBRE </option>
                                        }
                                    }
                                }

                            </select>
                        </div>
                        <div class="form-group col-md-2 mt-3">
                            <label>Cliente</label>
                            <select id="cliente" name="cliente" class="form-select" data-control="select2" data-placeholder="Filtrar por un cliente">
                                <option></option>
                                <option selected value="0">Todos</option>
                                @{
                                    if (ViewBag.Clientes != null)
                                    {
                                        foreach (var item in ViewBag.Clientes)
                                        {
                                            <option value="@item.CLIENTE">@item.CLIENTE - @item.ALIAS </option>
                                        }
                                    }
                                }

                            </select>
                        </div>


                        <div class="form-group col-md-4 mt-3">
                            <label>Logística</label>
                            <select id="ruta" name="ruta" class="form-select" data-control="select2" multiple data-placeholder="Filtrar por una ruta">
                                <option></option>
                                <option selected value="0">Todas</option>
                                @{
                                    if (ViewBag.Rutas != null)
                                    {
                                        foreach (var item in ViewBag.Rutas)
                                        {
                                            <option value="@item.RUTA"> @item.RUTA-@item.DESCRIPCION</option>
                                        }
                                    }
                                }

                            </select>
                        </div>
                        <div class="form-group col-md-4 mt-3">
                            <label>Días de logística</label>
                            <select id="kt_select2_9" name="kt_select2_9" class="form-select" data-control="select2" multiple data-placeholder="Filtrar por un seguimiento">
                                <option></option>
                                <option selected value="0">Todas</option>
                                <option value="L">L</option>
                                <option value="K">K</option>
                                <option value="M">M</option>
                                <option value="J">J</option>
                                <option value="V">V</option>
                                <option value="S">S</option>

                            </select>
                        </div>
                        <div class="form-group col-md-2 mt-3">
                            <label>Hora de corte</label>
                            <select id="HORA_FUERA_ENCORTE" name="HORA_FUERA_ENCORTE" class="form-select" data-control="select2" data-placeholder="Filtrar por hora de corte">
                                <option></option>
                                <option selected value="0">Todos</option>
                                <option value="1">En Corte</option>
                                <option value="2">Fuera Corte</option>

                            </select>
                        </div>
                    </div>
                    <div class="row align-items-center mt-3">

                        <div class="form-group  col-md-6 mt-3 ">
                            <label>Filtro múltiple por código de Factura</label>
                            <input id="kt_select2_10" name="kt_select2_10" class="form-control" />
                        </div>
                        <div class="col-md-2 mt-8">
                            <div class="input-icon">
                                <input type="text" class="form-control" placeholder="Buscar..." id="kt_datatable_search_query" data-kt-docs-table-filter="search" autocomplete="off" />
                                <span>
                                    <i class="flaticon2-search-1 text-muted"></i>
                                </span>
                            </div>
                        </div>
                        <div class="col-md-4 mt-8 d-flex justify-content-start align-items-center" data-kt-subscription-table-toolbar="selected">
                            <div class="fw-bold me-5">
                                <span id="totallineas" class="badge badge-lg badge-light-primary badge-lg me-2">Total líneas</span>
                            </div>
                            @if (Array.IndexOf(Session["PERMISOS_TRACKING_IN"].ToString().Split(','), "7") != -1)
                            {
                                <button type="button" class="btn btn-primary me-3" data-kt-subscription-table-select="delete_selected" onclick="ManejarFiltros()">Aplicar filtros</button>
                            }
                            @if (Array.IndexOf(Session["PERMISOS_TRACKING_IN"].ToString().Split(','), "8") != -1)
                            {
                                <button type="button" class="btn btn-secondary me-3" data-kt-subscription-table-select="delete_selected" onclick="LimpiarFiltros()">Limpiar filtros</button>
                            }
                        </div>
                    </div>
                </div>
                <!--end::Card body-->
            </div>
            <!--end::Card-->
            <!--begin::Card-->
            <div class="card">
                <!--begin::Card body-->
                <div class="card-body pt-0">

                    <!--begin::Table-->
                    <table class="table align-middle table-row-dashed fs-6 gy-4" id="miTabla">
                        <!--begin::Table head-->
                        <thead>
                            <!--begin::Table row-->
                            <tr class="text-start text-gray-600 fw-bold fs-7 text-uppercase gs-0">

                                <th class="min-w-10 pe-2">
                                    <div class="form-check form-check-sm form-check-custom form-check-solid me-3">
                                        <input class="form-check-input" id="checkAll" type="checkbox" data-kt-check="true" data-kt-check-target="#miTabla .form-check-input" value="1" />
                                    </div>
                                </th>
                                <th class="text-left min-w-10 verSubtabla"></th>
                                <th class="text-left min-w-90px">Pedido</th>
                                <th class="text-left min-w-90px">Factura</th>
                                <th class="text-left min-w-250px">Observación</th>
                                <th class="text-left min-w-70px ">T CORTE</th>
                                <th class="text-left min-w-85px ">Fecha ped</th>
                                <th class="text-center min-w-150px">Recibido TLA</th>
                                <th class="text-left min-w-100px">Estado PED</th>
                                <th class="text-left min-w-80px">Fecha ruta</th>
                                <th class="text-left min-w-60px">Seguir FAC</th>
                                <th class="text-left min-w-175px">Cliente</th>
                                <th class="text-left min-w-100px">Acciones</th>
                                <th class="text-left min-w-150px">Ruta</th>
                                <th class="text-left min-w-125px">Agente</th>
                                <th class="text-left min-w-25px">Día</th>
                                <th class="text-left min-w-25px">TLA</th>
                                <th class="text-left min-w-25px">corte</th>
                                @*<th class="text-end"></th>*@
                            </tr>
                            <!--end::Table row-->
                        </thead>
                        <!--end::Table head-->
                        <!--begin::Table body-->
                        <tbody class="fw-bold text-gray-600">
                        </tbody>
                        <!--end::Table body-->
                    </table>
                    <!--end::Table-->
                </div>
                <!--end::Card body-->
            </div>
            <!--end::Card-->
        </div>
        <!--end::Content container-->
    </div>
    <!--end::Content-->
</div>
<!--end::Content wrapper-->
@*+++++++++++++++++++++++++++++++++++++++++++++++++ MODAL DE CAMBIO DE SEGUIR FAC+++++++++++++++++++++++++++++++++++++++++++++++++++*@
<div class="modal fade" tabindex="-1" id="entregar2">
    <div class="modal-dialog modal-dialog-centered ">
        <div class="modal-content">
            <div class="modal-header">
                <h3 class="modal-title" id="entregotitulo2"></h3>

                <!--begin::Close-->
                <div class="btn btn-icon btn-sm btn-active-light-primary ms-2" data-bs-dismiss="modal" aria-label="Close">
                    <span class="svg-icon svg-icon-muted svg-icon-2x">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path opacity="0.3" d="M6 19.7C5.7 19.7 5.5 19.6 5.3 19.4C4.9 19 4.9 18.4 5.3 18L18 5.3C18.4 4.9 19 4.9 19.4 5.3C19.8 5.7 19.8 6.29999 19.4 6.69999L6.7 19.4C6.5 19.6 6.3 19.7 6 19.7Z" fill="currentColor" />
                            <path d="M18.8 19.7C18.5 19.7 18.3 19.6 18.1 19.4L5.40001 6.69999C5.00001 6.29999 5.00001 5.7 5.40001 5.3C5.80001 4.9 6.40001 4.9 6.80001 5.3L19.5 18C19.9 18.4 19.9 19 19.5 19.4C19.3 19.6 19 19.7 18.8 19.7Z" fill="currentColor" />
                        </svg>
                    </span>
                </div>
                <!--end::Close-->
            </div>

            <div class="modal-body">
                <div class="row">


                    <div class="form-group mb-6">
                        <label>Seguir FAC</label>
                        <select id="segasignar" name="segasignar" class="form-select" data-control="select2" data-placeholder="Seleccione un opción">
                            <option></option>
                            @{
                                if (ViewBag.EstadoFactura != null)
                                {
                                    foreach (var item in ViewBag.EstadoFactura)
                                    {
                                        <option value="@item.ESTADO_FACTURA_SEGUIMIENTO">@item.DESCRIPCION</option>
                                    }
                                }
                            }

                        </select>
                    </div>
                    <div class="form-group mb-6">
                        <label>Observaciones (opcional)</label>
                        <textarea class="form-control text-gray-500" rows="3" placeholder="" id="Observacionesseges"></textarea>
                    </div>
                    <div class="form-group mb-6">
                        <label>Entregado por</label>
                        <select id="entregando" name="entregando" disabled class="form-select form-control-solid" data-control="select2" data-placeholder="Filtrar por un estado">
                            <option></option>
                            <option selected value="@((string) Session["Usuario"])">@((string) Session["Usuario"])</option>

                        </select>
                    </div>

                    <div class="form-group mb-6">
                        <label>Fecha</label>
                        <input type="text" disabled class="form-control filtro" id="fecha3" name="start" autocomplete="off" value="@(DateTime.Now.ToString("dd/MM/yyyy hh:mm:ss tt"))" />
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" onclick="guardarEstadoFacturaMulti()" class="btn btn-primary" value="Default">Enviar Reporte Entrega</button>
                <button type="button" onclick="guardarEstadoFacturaMulti(this.value)" class="btn btn-success" value="Default">Guardar</button>
            </div>
        </div>
    </div>
</div>
@*+++++++++++++++++++++++++++++++++++++++++++++++++ MODAL DE CAMBIO DE ESTADO +++++++++++++++++++++++++++++++++++++++++++++++++++*@
<div class="modal fade" tabindex="-1" id="CambiarestadoPedido">
    <div class="modal-dialog modal-dialog-centered ">
        <div class="modal-content">
            <div class="modal-header">
                <h3 class="modal-title" id="estadoPedido"></h3>

                <!--begin::Close-->
                <div class="btn btn-icon btn-sm btn-active-light-primary ms-2" data-bs-dismiss="modal" aria-label="Close">
                    <span class="svg-icon svg-icon-muted svg-icon-2x">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path opacity="0.3" d="M6 19.7C5.7 19.7 5.5 19.6 5.3 19.4C4.9 19 4.9 18.4 5.3 18L18 5.3C18.4 4.9 19 4.9 19.4 5.3C19.8 5.7 19.8 6.29999 19.4 6.69999L6.7 19.4C6.5 19.6 6.3 19.7 6 19.7Z" fill="currentColor" />
                            <path d="M18.8 19.7C18.5 19.7 18.3 19.6 18.1 19.4L5.40001 6.69999C5.00001 6.29999 5.00001 5.7 5.40001 5.3C5.80001 4.9 6.40001 4.9 6.80001 5.3L19.5 18C19.9 18.4 19.9 19 19.5 19.4C19.3 19.6 19 19.7 18.8 19.7Z" fill="currentColor" />
                        </svg>
                    </span>
                </div>
                <!--end::Close-->
            </div>

            <div class="modal-body">
                <div class="row">


                    <div class="form-group mb-6">
                        <label>Estado PED</label>
                        <select id="asignarestadopedido" name="asignarestadopedido" class="form-select" data-control="select2" data-placeholder="Seleccione un estado">
                            <option></option>
                            @{
                                if (ViewBag.EstadoPedido != null)
                                {
                                    foreach (var item in ViewBag.EstadoPedido)
                                    {
                                        <option value="@item.ESTADO_PEDIDO">@item.DESCRIPCION</option>
                                    }
                                }
                            }

                        </select>
                    </div>
                    <div class="form-group mb-6">
                        <label>Fecha Cambio Estado </label>
                        <input type="text" class="form-control text-gray-500" id="FechaPedidoIndividual" data-td-toggle="datetimepicker" style="font-size:0.90rem;" data-td-target="#FechaPedidoIndividual" name="start" autocomplete="off" value="@(DateTime.Now.ToString("MM/dd/yyyy"))" />
                    </div>
                    <div class="form-group mb-6">
                        <label>Observaciones del cambio</label>
                        <textarea class="form-control text-gray-500" rows="3" placeholder="" id="Observacionesseges2"></textarea>
                    </div>
                    <div class="form-group mb-6">
                        <label>Agregar destinatarios</label>
                        <textarea class="form-control text-gray-500" rows="3" placeholder="Ingrese destinatarios" id="correosPedidoIndividual">glt@grupoancla.co.cr;</textarea>
                        <div class="text-muted fs-7">Cada destinatario debe ir separado por un ;.</div>
                    </div>
                    <div class="form-group mb-6">
                        <label>Entrega</label>
                        <select id="entregando2" name="entregando2" disabled class="form-select form-control-solid" data-control="select2" data-placeholder="Filtrar por un estado">
                            <option></option>
                            <option selected value="@((string) Session["Usuario"])">@((string) Session["Usuario"])</option>

                        </select>
                    </div>
                    <div class="form-group mb-6">
                        <label>Fecha</label>
                        <input type="text" disabled class="form-control filtro" id="fecha32" name="start" autocomplete="off" value="@(DateTime.Now.ToString("dd/MM/yyyy hh:mm:ss tt"))" />
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" onclick="guardarEstadoPedido()" class="btn btn-success">Enviar</button>
            </div>
        </div>
    </div>
</div>
@*+++++++++++++++++++++++++++++++++++++++++++++++++ MODAL DE CAMBIO DE ESTADO MULTIPLE +++++++++++++++++++++++++++++++++++++++++++++++++++*@
<div class="modal fade" tabindex="-1" id="facturas">
    <div class="modal-dialog modal-dialog-centered ">
        <div class="modal-content">
            <div class="modal-header">
                <h3 class="modal-title" id="factt">Cambio de estado del pedido</h3>

                <!--begin::Close-->
                <div class="btn btn-icon btn-sm btn-active-light-primary ms-2" data-bs-dismiss="modal" aria-label="Close">
                    <span class="svg-icon svg-icon-muted svg-icon-2x">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path opacity="0.3" d="M6 19.7C5.7 19.7 5.5 19.6 5.3 19.4C4.9 19 4.9 18.4 5.3 18L18 5.3C18.4 4.9 19 4.9 19.4 5.3C19.8 5.7 19.8 6.29999 19.4 6.69999L6.7 19.4C6.5 19.6 6.3 19.7 6 19.7Z" fill="currentColor" />
                            <path d="M18.8 19.7C18.5 19.7 18.3 19.6 18.1 19.4L5.40001 6.69999C5.00001 6.29999 5.00001 5.7 5.40001 5.3C5.80001 4.9 6.40001 4.9 6.80001 5.3L19.5 18C19.9 18.4 19.9 19 19.5 19.4C19.3 19.6 19 19.7 18.8 19.7Z" fill="currentColor" />
                        </svg>
                    </span>
                </div>
                <!--end::Close-->
            </div>

            <div class="modal-body">
                <div class="row">


                    <div class="form-group mb-6">
                        <label>Estado</label>
                        <select id="cambioestado" name="cambioestado" class="form-select" data-control="select2" data-placeholder="Seleccione un estado">
                            <option></option>
                            @{
                                if (ViewBag.EstadoPedido != null)
                                {
                                    foreach (var item in ViewBag.EstadoPedido)
                                    {
                                        <option value="@item.ESTADO_PEDIDO">@item.DESCRIPCION</option>
                                    }
                                }
                            }

                        </select>
                    </div>
                    <div class="form-group mb-6">
                        <label>Fecha Cambio Estado </label>
                        <input type="text" class="form-control text-gray-500" id="FechaCambioEstado" data-td-toggle="datetimepicker" style="font-size:0.90rem;" data-td-target="#FechaCambioEstado" name="FechaCambioEstado" autocomplete="off" value="@(DateTime.Now.ToString("MM/dd/yyyy"))" />
                    </div>

                    <div class="form-group mb-6">
                        <label>Observaciones del cambio (opcional)</label>
                        <textarea class="form-control text-gray-500" rows="3" placeholder="" id="Observacionescambioestado"></textarea>
                    </div>
                    <div class="form-group mb-6">
                        <label>Agregar destinatarios</label>
                        <textarea class="form-control text-gray-500" rows="3" placeholder="Ingrese destinatarios" id="correoPedidos">glt@grupoancla.co.cr;</textarea>
                        <div class="text-muted fs-7">Cada destinatario debe ir separado por un ;.</div>
                    </div>
                    <div class="form-group mb-6">
                        <label>Entrega</label>
                        <select id="entregando" name="entregando" disabled class="form-select form-control-solid" data-control="select2" data-placeholder="Filtrar por un estado">
