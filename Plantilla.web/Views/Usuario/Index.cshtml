@*++++++++++++++++++++++++++++++++++++++++++++++++MODAL EDITAR USUARIO ++++++++++++++++++++++++++++++++++++++++++++++++++++++*@
<div class="modal fade" tabindex="-1" id="modalEditarUsuario">
    <div class="modal-dialog modal-dialog-centered ">
        <div class="modal-content">
            <div class="modal-header">
                <h3 class="modal-title" id="modalEditarUsuarioLabel">Modificar Usuario</h3>

                <!--begin::Close-->
                <div class="btn btn-icon btn-sm btn-active-light-primary ms-2" data-bs-dismiss="modal" aria-label="Close">
                    <span class="svg-icon svg-icon-muted svg-icon-2x">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path opacity="0.3" d="M6 19.7C5.7 19.7 5.5 19.6 5.3 19.4C4.9 19 4.9 18.4 5.3 18L18 5.3C18.4 4.9 19 4.9 19.4 5.3C19.8 5.7 19.8 6.29999 19.4 6.69999L6.7 19.4C6.5 19.6 6.3 19.7 6 19.7Z" fill="currentColor" />
                            <path d="M18.8 19.7C18.5 19.7 18.3 19.6 18.1 19.4L5.40001 6.69999C5.00001 6.29999 5.00001 5.7 5.40001 5.3C5.80001 4.9 6.40001 4.9 6.80001 5.3L19.5 18C19.9 18.4 19.9 19 19.5 19.4C19.3 19.6 19 19.7 18.8 19.7Z" fill="currentColor" />
                        </svg>
                    </span>
                </div>
                <!--end::Close-->
            </div>

            <div class="modal-body">
                <form id="frm-editar-usuario" class="row">
                    <div class="form-group mb-6">
                        <label for="Usuario">Usuario</label>
                        <input disabled type="text" class="form-control text-gray-500" id="UsuarioEditar" style="font-size:0.90rem;" name="Usuario" autocomplete="off" value="" placeholder="" />
                    </div>
                    <div class="form-group mb-6">
                        <label for="Empleado">Colaborador</label>
                        <input disabled type="text" class="form-control text-gray-500" id="EditarColaborador" style="font-size:0.90rem;" name="Empleado" placeholder="" autocomplete="off" value="" />
                    </div>
                    <div class="form-group mb-6">
                        <label for="RolUsuario">Rol</label>
                        <select id="RolUsuarioEditar" name="RolUsuario" class="form-select  rol-usuario" data-control="select2" data-placeholder="Seleccione un rol" data-dropdown-parent="#modalEditarUsuario">
                            <option></option>
                            @if (ViewBag.Roles != null)
                            {
                                foreach (var item in ViewBag.Roles)
                                {
                                    <option value="@item.ROL">@item.DESCRIPCION</option>
                                }
                            }
                        </select>
                    </div>

                    <div class="form-group mb-6">
                        <label for="RolUsuario">Vendedor</label>
                        <select id="VendedorUsuario" name="VendedorUsuario" class="form-select  rol-usuario" data-control="select2" data-placeholder="Seleccione un vendedor" data-dropdown-parent="#modalEditarUsuario">
                            <option></option>
                            <option selected value="0">Seleccionar una vendedor</option>
                            @{
                                if (ViewBag.Vendedor_Usuario != null)
                                {
                                    foreach (var item in ViewBag.Vendedor_Usuario)



                                    {
                                        <option value="@item.VENDEDOR">@item.VENDEDOR - @item.NOMBRE </option>
                                    }
                                }
                            }

                        </select>
                    </div>

                    <div class="form-group mb-6">
                        <label for="RolUsuario">Cobrador</label>
                        <select id="CobradorUsuario" name="CobradorUsuario" class="form-select  rol-usuario" data-control="select2" data-placeholder="Seleccione un cobrador" data-dropdown-parent="#modalEditarUsuario">
                            <option></option>
                            <option selected value="0">Seleccionar una cobrador</option>
                            @{
                                if (ViewBag.Cobrador_Usuario != null)
                                {
                                    foreach (var item in ViewBag.Cobrador_Usuario)
                                    {
                                        <option value="@item.COBRADOR">@item.COBRADOR - @item.NOMBRE </option>
                                    }
                                }
                            }
                        </select>
                    </div>

                    <div class="form-group mb-6">
                        <label for="RolUsuario">Bodega</label>
                        <select id="BodegaUsuario" name="BodegaUsuario" class="form-select  rol-usuario" data-control="select2" data-placeholder="Seleccione un bodega" data-dropdown-parent="#modalEditarUsuario">
                            <option></option>
                            <option selected value="0">Seleccionar una bodega</option>
                            @if (ViewBag.Bodega_Usuario != null)
                            {
                                // Primero buscamos y mostramos la opción con el valor "01"
                                var bodega01Encontrada = false;
                                foreach (var item in ViewBag.Bodega_Usuario)
                                {
                                    if (item.BODEGA == "01")
                                    {
                                        <option selected value="@item.BODEGA">@item.BODEGA - @item.NOMBRE</option>
                                        bodega01Encontrada = true;
                                        break; // Salimos del bucle una vez que encontramos la bodega "01"
                                    }
                                }

                                // Luego, si no se encontró la bodega "01", mostramos el resto de las opciones
                                if (!bodega01Encontrada)
                                {
                                    foreach (var item in ViewBag.Bodega_Usuario)
                                    {
                                        <option value="@item.BODEGA">@item.BODEGA - @item.NOMBRE</option>
                                    }
                                }
                            }
                        </select>
                    </div>

                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" id="btn-editar-usuario" value="Default" class="btn btn-success">Guardar</button>
            </div>
        </div>
    </div>
</div>
@*++++++++++++++++++++++++++++++++++++++++++++++++MODAL NUEVO USUARIO ++++++++++++++++++++++++++++++++++++++++++++++++++++++*@
<div class="modal fade" tabindex="-1" id="modalInsertarUsuario">
    <div class="modal-dialog modal-dialog-centered ">
        <div class="modal-content">
            <div class="modal-header">
                <h3 class="modal-title">Registrar Usuario</h3>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>

            <div class="modal-body">
                <form class="row" id="frm-insertar-usuario" novalidate>
                    <input type="hidden" id="cedjudMantenimientoUsuario" name="username" />

                    <div class="form-group mb-3 col-12">
                        <label for="nombreMantenimientoUsuario">Nombre <span class="text-danger">*</span></label>
                        <input type="text"
                               class="form-control"
                               id="nombreMantenimientoUsuario"
                               name="Descripcion"
                               autocomplete="off"
                               required />
                    </div>

                    <div class="form-group mb-3 col-12">
                        <label for="idusuarioMantenimientoUsuario">Usuario <span class="text-danger">*</span></label>
                        <input type="text"
                               class="form-control"
                               id="idusuarioMantenimientoUsuario"
                               name="desc"
                               placeholder="Ingrese el nombre de usuario"
                               autocomplete="off"
                               required />
                    </div>

                    <div class="form-group mb-3 col-12">
                        <label for="correo_electronicoMantenimientoUsuario">Correo electrónico <span class="text-danger">*</span></label>
                        <input type="email"
                               class="form-control"
                               id="correo_electronicoMantenimientoUsuario"
                               name="desc"
                               placeholder="usuario@dominio.com"
                               autocomplete="off"
                               required />
                    </div>
                    <div class="form-group mb-3 col-12">
                        <label for="identificacionMantenimientoUsuario">Identificación <span class="text-danger">*</span></label>
                        <input type="text"
                               class="form-control"
                               id="identificacionMantenimientoUsuario"
                               name="identificacion"
                               placeholder="Ingrese la identificación"
                               maxlength="15"
                               pattern="[A-Za-z0-9]*"
                               autocomplete="off"
                               required
                               oninput="this.value = this.value.replace(/[^A-Za-z0-9]/g, '').slice(0,15)" />
                    </div>

                    <div class="form-group mb-3 col-12">
                        <label for="RolUsuarioIns">Rol <span class="text-danger">*</span></label>
                        <select id="RolUsuarioIns"
                                name="rol"
                                class="form-select"
                                data-control="select2"
                                data-placeholder="Seleccione un rol"
                                data-dropdown-parent="#modalInsertarUsuario"
                                required>
                            <option value="" disabled selected hidden>Seleccione un rol</option>
                            @if (ViewBag.Roles != null)
                            {
                                foreach (var item in ViewBag.Roles)
                                {
                                    <option value="@item.ROL">@item.DESCRIPCION</option>
                                }
                            }
                        </select>


                    </div>

                    <div class="form-group mb-3 col-12">
                        <label for="VendedorRegistrar">Vendedor <span class="text-danger">*</span></label>
                        <select id="VendedorRegistrar" name="VendedorRegistrar" class="form-select  rol-usuario" data-control="select2" data-placeholder="Seleccione un vendedor" data-dropdown-parent="#modalInsertarUsuario">
                            <option></option>
                            <option selected value="0">Seleccionar una vendedor</option>
                            @{
                                if (ViewBag.Vendedor_Usuario != null)
                                {
                                    foreach (var item in ViewBag.Vendedor_Usuario)



                                    {
                                        <option value="@item.VENDEDOR">@item.VENDEDOR - @item.NOMBRE </option>
                                    }
                                }
                            }

                        </select>
                    </div>

                    <div class="form-group mb-3 col-12">
                        <label for="CobradorRegistrar">Cobrador <span class="text-danger">*</span></label>


                        <select id="CobradorRegistrar" name="CobradorRegistrar" class="form-select  rol-usuario" data-control="select2" data-placeholder="Seleccione un cobrador" data-dropdown-parent="#modalInsertarUsuario">
                            <option></option>
                            <option selected value="0">Seleccionar una cobrador</option>
                            @{
                                if (ViewBag.Cobrador_Usuario != null)
                                {
                                    foreach (var item in ViewBag.Cobrador_Usuario)
                                    {
                                        <option value="@item.COBRADOR">@item.COBRADOR - @item.NOMBRE </option>
                                    }
                                }
                            }
                        </select>
                    </div>

                    <div class="form-group mb-3 col-12">
                        <label for="BodegaRegistrar">Bodega <span class="text-danger">*</span></label>

                        <select id="BodegaRegistrar" name="BodegaRegistrar" class="form-select  rol-usuario" data-control="select2" data-placeholder="Seleccione un bodega" data-dropdown-parent="#modalInsertarUsuario">
                            <option></option>
                            <option selected value="0">Seleccionar una bodega</option>
                            @if (ViewBag.Bodega_Usuario != null)
                            {
                                var bodega01Encontrada = false;
                                foreach (var item in ViewBag.Bodega_Usuario)
                                {
                                    if (item.BODEGA == "01")
                                    {
                                        <option selected value="@item.BODEGA">@item.BODEGA - @item.NOMBRE</option>
                                        bodega01Encontrada = true;
                                        break;
                                    }
                                }

                                if (!bodega01Encontrada)
                                {
                                    foreach (var item in ViewBag.Bodega_Usuario)
                                    {
                                        <option value="@item.BODEGA">@item.BODEGA - @item.NOMBRE</option>
                                    }
                                }
                            }
                        </select>
                    </div>

                    <div class="form-group mb-3 col-12">
                        <label for="passwordMantenimientoUsuario">Contraseña <span class="text-danger">*</span></label>
                        <input type="password"
                               class="form-control"
                               id="passwordMantenimientoUsuario"
                               name="desc"
                               placeholder="Ingrese una contraseña"
                               autocomplete="new-password"
                               required />
                    </div>

                    <div class="form-group mb-3 col-12">
                        <label for="rpasswordMantenimientoUsuario">Confirmar contraseña <span class="text-danger">*</span></label>
                        <input type="password"
                               class="form-control"
                               id="rpasswordMantenimientoUsuario"
                               name="desc"
                               placeholder="Confirme la contraseña"
                               autocomplete="new-password"
                               required />
                    </div>
                </form>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" id="btn-insertar-usuario" class="btn btn-success">Guardar</button>
            </div>
        </div>
    </div>
</div>
