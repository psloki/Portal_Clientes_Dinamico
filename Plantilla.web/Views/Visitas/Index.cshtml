
@{
    ViewBag.Title = "Visitas";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<!--begin::Content wrapper-->
<div class="d-flex flex-column flex-column-fluid">

    <!--begin::Content-->
    <div id="kt_app_content" class="app-content flex-column-fluid">
        <!--begin::Content container-->
        <div id="kt_app_content_container" class="app-container container-xxl" style="max-width:100% !important">
            <!--begin::Toolbar-->
            <div id="kt_app_toolbar" class="app-toolbar py-3 py-lg-6">
                <!--begin::Page title-->
                <div class="page-title d-flex flex-column justify-content-center flex-wrap me-3">
                    <!--begin::Title-->
                    <h1 class="page-heading d-flex text-dark fw-bold fs-3 flex-column justify-content-center my-0">@ViewBag.Title</h1>
                    <!--end::Title-->
                </div>
                <!--end::Page title-->
            </div>
            <!--end::Toolbar-->
            <!--begin::Card-->
            <div class="card mb-6">
                <!--begin::Card body-->
                <div class="card-body pt-0">
                    <div class="row align-items-center mt-7">

                        <div class="form-group col-md-3 mt-3">
                            <label>Rango de fechas</label>
                            <input class="form-control filtro" placeholder="Pick date rage" id="FechaInicioV" value="@((new DateTime(DateTime.Now.Year, DateTime.Now.Month, 1).ToString("dd/MM/yyyy"))+ " - " + DateTime.Now.ToString("dd/MM/yyyy"))" />
                        </div>

                        <div class="form-group col-md-3 mt-3 ">
                            <label>Semana</label>
                            <select id="semanaV" name="pedido" class="form-select filtro_multiple" multiple data-control="select2" data-placeholder="Filtrar por semana">
                                <option></option>
                                <option selected value="0">Todos</option>
                                @{
                                    if (ViewBag.SemanaVisita != null)
                                    {
                                        foreach (var item in ViewBag.SemanaVisita)
                                        {
                                            <option value="@item.semana">@item.Descripcion | @item.inicio_semana | @item.fin_semana</option>
                                        }
                                    }
                                }
                            </select>
                        </div>

                        <div class="form-group col-md-2 mt-3">
                            <label>Día de la semana</label>
                            <select id="diaV" name="diaV" class="form-select filtro" data-control="select2" data-placeholder="Filtrar por un día">
                                <option></option>
                                <option selected value="0">Todos</option>
                                <option value="L">Lunes</option>
                                <option value="K">Martes</option>
                                <option value="M">Miercoles</option>
                                <option value="J">Jueves</option>
                                <option value="V">Viernes</option>
                                <option value="S">Sabado</option>

                            </select>
                        </div>
                        <div class="form-group col-md-2 mt-3">
                            <label>Tipo</label>
                            <select id="TipoV" name="TipoV" class="form-select filtro" data-control="select2" data-placeholder="Filtrar por seguir fact">
                                <option selected value="0">Todas</option>
                                @{
                                    if (ViewBag.TipoVisita != null)
                                    {
                                        foreach (var item in ViewBag.TipoVisita)
                                        {
                                            <option value="@item.U_CODIGO">@item.U_DESCRIP </option>
                                        }
                                    }
                                }
                            </select>
                        </div>
                        <div class="col-md-2 mt-8">
                            <div class="input-icon">
                                <input type="text" class="form-control" placeholder="Buscar..." id="kt_datatable_search_query" data-kt-docs-table-filter="search" autocomplete="off" />
                                <span>
                                    <i class="flaticon2-search-1 text-muted"></i>
                                </span>
                            </div>
                        </div>

                    </div>
                </div>
                <!--end::Card body-->
            </div>
            <!--end::Card-->
            <!--begin::Card-->
            <div class="card table-container">
                <!--begin::Card body-->
                <div class="card-body pt-0">
                    <div class="table-responsive">
                        <!--begin::Table-->
                        <table class="table align-middle table-row-dashed fs-6 gy-4" id="miTabla">
                            <!--begin::Table head-->
                            <thead>
                                <!--begin::Table row-->
                                <tr class="text-start text-gray-600 fw-bold fs-7 text-uppercase gs-0">


                                    <th class="text-left min-w-200px">Cliente</th>
                                    <th class="text-left min-w-100px ">Vendedor</th>
                                    <th class="text-left min-w-80px ">Realizada</th>
                                    <th class="text-left min-w-100px">Ruta</th>
                                    <th class="text-left min-w-100px">Provincia</th>
                                    <th class="text-left min-w-200px">Dirección</th>
                                    <th class="text-left min-w-50px">Tipo</th>
                                    <th class="min-w-75px" style="text-align:right">Total</th>
                                    <th class="text-left min-w-100px">Comentario</th>
                                    <th class="text-left min-w-75px">Acciones</th>
                                    @*<th class="text-end"></th>*@
                                </tr>
                                <!--end::Table row-->
                            </thead>
                            <!--end::Table head-->
                            <!--begin::Table body-->
                            <tbody class="fw-bold text-gray-600">
                            </tbody>
                            <!--end::Table body-->
                        </table>
                        <!--end::Table-->
                    </div>
                    
                </div>
                <!--end::Card body-->
            </div>
            <!--end::Card-->
        </div>
        <!--end::Content container-->
    </div>
    <!--end::Content-->
</div>
<!--end::Content wrapper-->


<div class="modal fade" tabindex="-1" id="modalvisita">
    <div class="modal-dialog modal-dialog-centered ">
        <div class="modal-content">
            <div class="modal-header">
                <h3 class="modal-title" id="labelvisita">Agregar nueva visita</h3>

                <!--begin::Close-->
                <div class="btn btn-icon btn-sm btn-active-light-primary ms-2" data-bs-dismiss="modal" aria-label="Close">
                    <span class="svg-icon svg-icon-muted svg-icon-2x">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path opacity="0.3" d="M6 19.7C5.7 19.7 5.5 19.6 5.3 19.4C4.9 19 4.9 18.4 5.3 18L18 5.3C18.4 4.9 19 4.9 19.4 5.3C19.8 5.7 19.8 6.29999 19.4 6.69999L6.7 19.4C6.5 19.6 6.3 19.7 6 19.7Z" fill="currentColor" />
                            <path d="M18.8 19.7C18.5 19.7 18.3 19.6 18.1 19.4L5.40001 6.69999C5.00001 6.29999 5.00001 5.7 5.40001 5.3C5.80001 4.9 6.40001 4.9 6.80001 5.3L19.5 18C19.9 18.4 19.9 19 19.5 19.4C19.3 19.6 19 19.7 18.8 19.7Z" fill="currentColor" />
                        </svg>
                    </span>
                </div>
                <!--end::Close-->
            </div>

            <div class="modal-body">
                <div class="row">

                    <div class="form-group mb-6">
                        <label>Cliente</label>
                        <input id="clientevisita" type="text" class="form-control text-gray-500" style="font-size:0.90rem;" value="" />
                    </div>
                    <div class="form-group mb-6">
                        <label>Tipo de visita</label>
                        <select id="tipovisita" name="tipovisita" class="form-select" data-control="select2" data-placeholder="Seleccione un tipo">
                            <option></option>
                            @{
                                if (ViewBag.TipoVisita != null)
                                {
                                    foreach (var item in ViewBag.TipoVisita)
                                    {
                                        <option value="@item.U_CODIGO">@item.U_DESCRIP</option>
                                    }
                                }
                            }
                        </select>
                    </div>
                    <div class="form-group mb-6">
                        <label>Fecha visita</label>
                        <input id="fechavisita" disabled type="text" class="form-control text-gray-500" style="font-size:0.90rem;" value="@(DateTime.Now.ToString("dd/MM/yyyy hh:mm:ss tt"))" />
                    </div>
                    <div class="form-group mb-6">
                        <label>Latitud</label>
                        <input id="latitudvisita" disabled type="text" class="form-control text-gray-500" style="font-size:0.90rem;" value="" />
                    </div>
                    <div class="form-group mb-6">
                        <label>Longitud</label>
                        <input id="longitudvisita" disabled type="text" class="form-control text-gray-500" style="font-size:0.90rem;" value="" />
                    </div>
                    <div class="form-group mb-6">
                        <label>Comentarios</label>
                        <textarea class="form-control text-gray-500" rows="2" placeholder="Ingrese un comentario" id="comentariovisita"></textarea>
                    </div>
                    <div class="form-group mb-6">
                        <label>Usuario</label>
                        <input id="usuariovisita" disabled type="text" class="form-control text-gray-500" style="font-size:0.90rem;" value="@Session["Usuario"].ToString()" />
                    </div>
                    <div class="form-group mb-6">
                        <label>Fecha creación</label>
                        <input id="fechavisita" disabled type="text" class="form-control text-gray-500" style="font-size:0.90rem;" value="@(DateTime.Now.ToString("dd/MM/yyyy"))" />
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" id="deleteButton" onclick="guardarVisita();" class="btn btn-success">Guardar</button>
            </div>
        </div>
    </div>
</div>


@*++++++++++++++++++++++++++++++++++++++++++++++++MODAL Ver PDF ++++++++++++++++++++++++++++++++++++++++++++++++++++++*@
<div class="modal fade" tabindex="-1" id="Modal_PDF">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h3 class="modal-title">Ver pdf</h3>

                <!--begin::Close-->
                <div class="btn btn-icon btn-sm btn-active-light-primary ms-2" data-bs-dismiss="modal" aria-label="Close">
                    <span class="svg-icon svg-icon-muted svg-icon-2x">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path opacity="0.3" d="M6 19.7C5.7 19.7 5.5 19.6 5.3 19.4C4.9 19 4.9 18.4 5.3 18L18 5.3C18.4 4.9 19 4.9 19.4 5.3C19.8 5.7 19.8 6.29999 19.4 6.69999L6.7 19.4C6.5 19.6 6.3 19.7 6 19.7Z" fill="currentColor" />
                            <path d="M18.8 19.7C18.5 19.7 18.3 19.6 18.1 19.4L5.40001 6.69999C5.00001 6.29999 5.00001 5.7 5.40001 5.3C5.80001 4.9 6.40001 4.9 6.80001 5.3L19.5 18C19.9 18.4 19.9 19 19.5 19.4C19.3 19.6 19 19.7 18.8 19.7Z" fill="currentColor" />
                        </svg>
                    </span>
                </div>
                <!--end::Close-->
            </div>

            <div class="modal-body">

                <div id="pdf_preview" class="d-none" style="pointer-events:auto;"><embed type="application/pdf" id="pdf" src="" style="width:100%; height:800px" /></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-light-primary" data-bs-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>
